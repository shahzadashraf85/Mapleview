    <Item class="ModuleScript" referent="RBX000004">
      <Properties>
        <string name="Name">Network</string>
        <ProtectedString name="Source"><![CDATA[--!strict
-- Network.luau
-- Centralizes RemoteEvents and RemoteFunctions so server and client never desync.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Network = {}

local REMOTE_EVENTS = {
	"BallStateUpdate",     -- Server -> Clients: authoritative ball pos/vel/spin/owner
	"KickRequest",         -- Client -> Server: Shoot / Pass / ThroughBall / Lob / FreeKick (with targetPos)
	"DribbleToggle",       -- Client -> Server: Request close control or release
	"TackleRequest",       -- Client -> Server: Slide tackle / steal attempt
	"GKDiveRequest",       -- Client -> Server: Goalkeeper dive direction
	"MatchStateUpdate",    -- Server -> Clients: timer, scores, phase, mode, stadium, set-piece info
	"GoalScoredVFX",       -- Server -> Clients: goal banner, net ripple, scorer info, fan cheer
	"CelebrationTrigger",  -- Client <-> Server: trigger equipped celebration
	"TrophyCeremonyStart", -- Server -> Clients: confetti & trophy lift FX
	"VoteMatchMode",       -- Client -> Server: vote 5v5 or 11v11
	"EquipItem",           -- Client -> Server: equip kit / celebration / formation
	"PurchaseItem",        -- Client -> Server: buy kit / celebration
	"UpdateClubName",      -- Client -> Server: set custom club name
	"ProfileUpdated",      -- Server -> Client: sync player profile & coins/ELO
	"AdminCommand",        -- Client -> Server: ninja373670 admin actions
	"TrainingBallKick",    -- Client -> Server: kick a practice ball on the lobby training pitch
	"ToggleAFK",           -- Client -> Server: toggle AFK (stay in lobby vs join match)
	"GlobalAnnouncement",  -- Server -> Clients: global chat/banner broadcast from admin
	"DiscoPartyStart",     -- Server -> Clients: 3-minute disco lights + raining tacos FX
	"OpenHammerPanel",     -- Server -> Client: triggered when ninja373670 activates the Hammer Tool
}

local REMOTE_FUNCTIONS = {
	"GetProfile",          -- Client -> Server: fetch initial player data
	"GetLeaderboards",     -- Client -> Server: fetch global top scorers, ELO, wins
}

local function getOrCreateFolder(): Folder
	local existing = ReplicatedStorage:FindFirstChild("Remotes")
	if existing and existing:IsA("Folder") then
		return existing
	end
	if RunService:IsServer() then
		local folder = Instance.new("Folder")
		folder.Name = "Remotes"
		folder.Parent = ReplicatedStorage
		return folder
	else
		return ReplicatedStorage:WaitForChild("Remotes") :: Folder
	end
end

function Network.InitServer()
	local folder = getOrCreateFolder()
	for _, name in ipairs(REMOTE_EVENTS) do
		if not folder:FindFirstChild(name) then
			local ev = Instance.new("RemoteEvent")
			ev.Name = name
			ev.Parent = folder
		end
	end
	for _, name in ipairs(REMOTE_FUNCTIONS) do
		if not folder:FindFirstChild(name) then
			local fn = Instance.new("RemoteFunction")
			fn.Name = name
			fn.Parent = folder
		end
	end
end

function Network.GetEvent(name: string): RemoteEvent
	local folder = getOrCreateFolder()
	local ev = folder:WaitForChild(name, 15)
	assert(ev and ev:IsA("RemoteEvent"), "Missing RemoteEvent: " .. name)
	return ev :: RemoteEvent
end

function Network.GetFunction(name: string): RemoteFunction
	local folder = getOrCreateFolder()
	local fn = folder:WaitForChild(name, 15)
	assert(fn and fn:IsA("RemoteFunction"), "Missing RemoteFunction: " .. name)
	return fn :: RemoteFunction
end

return Network
]]></ProtectedString>
      </Properties>
    </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="RBX000020">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="ModuleScript" referent="RBX000005">
      <Properties>
        <string name="Name">BallManager</string>
        <ProtectedString name="Source"><![CDATA[--!strict
-- BallManager.luau
-- Server-authoritative soccer ball simulation, click-to-target kicks, AI Goalkeepers, training balls, and goal detection.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local BallPhysics = require(ReplicatedStorage.Shared.BallPhysics)
local Config = require(ReplicatedStorage.Shared.Config)
local Network = require(ReplicatedStorage.Shared.Network)
local GoalkeeperAI = require(script.Parent.GoalkeeperAI)

local BallManager = {}

local ballPart: Part? = nil
local ballState: BallPhysics.BallState = {
	Position = Vector3.new(0, Config.Ball.Radius, 0),
	Velocity = Vector3.zero,
	Spin = Vector3.zero,
}

local currentMode: Config.MatchMode = Config.DefaultMode
local matchPlaying = false
local ballFrozen = false

local ownerPlayer: Player? = nil
local lastTouchPlayer: Player? = nil
local previousTouchPlayer: Player? = nil
local stealCooldowns: { [number]: number } = {}
local divingPlayers: { [number]: number } = {}

local onGoalCallback: ((scoringTeam: "Home" | "Away", scorer: Player?, assister: Player?) -> ())? = nil
local onSaveCallback: ((keeper: Player) -> ())? = nil
local onAISaveCallback: (() -> ())? = nil
local onSetPieceCallback: ((kind: string, spot: Vector3, team: "Home" | "Away") -> ())? = nil

local function ensureBallPart(): Part
	if ballPart and ballPart.Parent then
		return ballPart
	end
	local existing = Workspace:FindFirstChild("SoccerBall")
	if existing and existing:IsA("Part") then
		ballPart = existing
		return existing
	end

	local p = Instance.new("Part")
	p.Name = "SoccerBall"
	p.Shape = Enum.PartType.Ball
	p.Size = Vector3.one * (Config.Ball.Radius * 2)
	p.Color = Color3.fromRGB(248, 250, 252)
	p.Material = Enum.Material.SmoothPlastic
	p.Anchored = true
	p.CanCollide = false
	p.CastShadow = true

	local highlight = Instance.new("Highlight")
	highlight.FillTransparency = 1
	highlight.OutlineColor = Color3.fromRGB(250, 204, 21)
	highlight.OutlineTransparency = 0.65
	highlight.Parent = p

	p.Parent = Workspace
	ballPart = p
	return p
end

function BallManager.ResetToSpot(pos: Vector3, freeze: boolean)
	ownerPlayer = nil
	ballState = {
		Position = Vector3.new(pos.X, Config.Ball.Radius, pos.Z),
		Velocity = Vector3.zero,
		Spin = Vector3.zero,
	}
	ballFrozen = freeze
	local bp = ensureBallPart()
	bp.CFrame = CFrame.new(ballState.Position)
end

function BallManager.SetMatchActive(active: boolean, mode: Config.MatchMode)
	matchPlaying = active
	currentMode = mode
	if not active then
		ballFrozen = false
	end
end

function BallManager.GetBallPosition(): Vector3
	return ballState.Position
end

local function recordTouch(player: Player)
	if lastTouchPlayer ~= player then
		previousTouchPlayer = lastTouchPlayer
		lastTouchPlayer = player
	end
end

local function isInPenaltyBox(pos: Vector3, halfL: number): boolean
	local inZ = math.abs(pos.Z) >= (halfL - Config.Kicks.GKBoxDepth) and math.abs(pos.Z) <= halfL + 4
	local inX = math.abs(pos.X) <= (Config.Kicks.GKBoxWidth * 0.5)
	return inZ and inX
end

local function broadcastState()
	Network.GetEvent("BallStateUpdate"):FireAllClients(
		ballState.Position,
		ballState.Velocity,
		ballState.Spin,
		if ownerPlayer then ownerPlayer.UserId else 0
	)
end

function BallManager.Init(
	onGoal: (scoringTeam: "Home" | "Away", scorer: Player?, assister: Player?) -> (),
	onSave: (keeper: Player) -> (),
	onAISave: () -> (),
	onSetPiece: (kind: string, spot: Vector3, team: "Home" | "Away") -> ()
)
	onGoalCallback = onGoal
	onSaveCallback = onSave
	onAISaveCallback = onAISave
	onSetPieceCallback = onSetPiece

	ensureBallPart()
	BallManager.ResetToSpot(Vector3.zero, false)

	-- Kick / Pass / Through-Ball / Click-to-Target Shot
	Network.GetEvent("KickRequest").OnServerEvent:Connect(
		function(player: Player, kickType: string, direction: Vector3, powerRatio: number, curveAmount: number, targetPos: Vector3?)
			if typeof(direction) ~= "Vector3" or type(powerRatio) ~= "number" or type(curveAmount) ~= "number" then
				return
			end
			local char = player.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
			if not hrp then
				return
			end

			local dist = (hrp.Position - ballState.Position).Magnitude
			if ownerPlayer ~= player and dist > 12 then
				return
			end

			local pwr = math.clamp(powerRatio, 0.1, 1)
			local curve = math.clamp(curveAmount, -1, 1)

			local speed = Config.Kicks.MinPower
			local loft = 0.18
			if kickType == "Shoot" or kickType == "FreeKick" then
				speed = Config.Kicks.MinPower + (Config.Kicks.MaxShotPower - Config.Kicks.MinPower) * pwr
				loft = 0.18 + 0.18 * pwr
			elseif kickType == "Lob" then
				speed = Config.Kicks.MinPower + (Config.Kicks.MaxLobPower - Config.Kicks.MinPower) * pwr
				loft = 0.52 + 0.2 * pwr
			elseif kickType == "ThroughBall" then
				speed = Config.Kicks.MinPower + (Config.Kicks.MaxThroughBallPower - Config.Kicks.MinPower) * pwr
				loft = 0.08
			else
				speed = Config.Kicks.MinPower + (Config.Kicks.MaxPassPower - Config.Kicks.MinPower) * pwr
				loft = 0.06
			end

			local launchDir: Vector3
			if typeof(targetPos) == "Vector3" then
				local toTarget = targetPos - ballState.Position
				local horizDist = Vector3.new(toTarget.X, 0, toTarget.Z).Magnitude
				if horizDist > 0.5 then
					-- Aim directly at clicked point with subtle gravity compensation arc
					local heightDiff = math.clamp(targetPos.Y - ballState.Position.Y, -2, 18)
					local arcLift = math.clamp(horizDist * 0.0045 + heightDiff / math.max(horizDist, 8), 0.05, 0.55)
					local flat = Vector3.new(toTarget.X, 0, toTarget.Z).Unit
					launchDir = Vector3.new(flat.X, arcLift, flat.Z).Unit
				else
					local dir = if direction.Magnitude > 0.01 then direction.Unit else hrp.CFrame.LookVector
					launchDir = Vector3.new(dir.X, loft, dir.Z).Unit
				end
			else
				local dir = if direction.Magnitude > 0.01 then direction.Unit else hrp.CFrame.LookVector
				launchDir = Vector3.new(dir.X, loft, dir.Z).Unit
			end

			ballState.Velocity = launchDir * speed
			ballState.Spin = Vector3.new(0, curve * Config.Kicks.MaxSpin * (0.4 + 0.6 * pwr), 0)

			ownerPlayer = nil
			ballFrozen = false
			stealCooldowns[player.UserId] = os.clock() + 0.35
			recordTouch(player)
			broadcastState()
		end
	)

	-- Lobby Training Pitch Ball Kick
	Network.GetEvent("TrainingBallKick").OnServerEvent:Connect(function(player: Player, ballInst: Instance, targetPos: Vector3, powerRatio: number)
		if typeof(ballInst) ~= "Instance" or not ballInst:IsA("BasePart") or not ballInst:GetAttribute("IsTrainingBall") then
			return
		end
		if typeof(targetPos) ~= "Vector3" or type(powerRatio) ~= "number" then
			return
		end
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		if not hrp or (hrp.Position - ballInst.Position).Magnitude > 14 then
			return
		end
		local toTarget = targetPos - ballInst.Position
		local flat = Vector3.new(toTarget.X, 0, toTarget.Z)
		if flat.Magnitude < 0.2 then
			flat = hrp.CFrame.LookVector
		end
		local pwr = math.clamp(powerRatio, 0.2, 1)
		local speed = Config.Kicks.MinPower + (Config.Kicks.MaxShotPower - Config.Kicks.MinPower) * pwr
		local arc = math.clamp(flat.Magnitude * 0.005 + (targetPos.Y - ballInst.Position.Y) / math.max(flat.Magnitude, 8), 0.12, 0.5)
		ballInst.AssemblyLinearVelocity = Vector3.new(flat.Unit.X, arc, flat.Unit.Z).Unit * speed
	end)

	Network.GetEvent("DribbleToggle").OnServerEvent:Connect(function(player: Player)
		if ownerPlayer == player then
			ownerPlayer = nil
			stealCooldowns[player.UserId] = os.clock() + 0.4
			ballState.Velocity = Vector3.new(ballState.Velocity.X, 0, ballState.Velocity.Z) * 0.5
		end
	end)

	Network.GetEvent("TackleRequest").OnServerEvent:Connect(function(player: Player)
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		if not hrp then
			return
		end
		if (hrp.Position - ballState.Position).Magnitude <= Config.Kicks.TackleRange then
			if ownerPlayer and ownerPlayer ~= player then
				stealCooldowns[ownerPlayer.UserId] = os.clock() + Config.Ball.StealCooldown
			end
			ownerPlayer = nil
			ballFrozen = false
			local pushDir = Vector3.new(hrp.CFrame.LookVector.X, 0.15, hrp.CFrame.LookVector.Z).Unit
			ballState.Velocity = pushDir * 42
			ballState.Spin = Vector3.zero
			recordTouch(player)
			broadcastState()
		end
	end)

	Network.GetEvent("GKDiveRequest").OnServerEvent:Connect(function(player: Player, _diveDir: Vector3)
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		if not hrp then
			return
		end
		local modeCfg = Config.MatchModes[currentMode]
		if isInPenaltyBox(hrp.Position, modeCfg.PitchLength * 0.5) then
			divingPlayers[player.UserId] = os.clock() + 0.65
		end
	end)

	local broadcastAccum = 0
	RunService.Heartbeat:Connect(function(dt: number)
		local stepDt = math.min(dt, 0.05)
		local modeCfg = Config.MatchModes[currentMode]
		local halfL = modeCfg.PitchLength * 0.5
		local halfW = modeCfg.PitchWidth * 0.5
		local now = os.clock()

		if not ballFrozen then
			if ownerPlayer then
				local char = ownerPlayer.Character
				local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
				local hum = char and char:FindFirstChildOfClass("Humanoid")
				if not hrp or not hum or hum.Health <= 0 then
					ownerPlayer = nil
				else
					local targetPos = hrp.Position + hrp.CFrame.LookVector * Config.Ball.DribbleDistance
					targetPos = Vector3.new(targetPos.X, Config.Ball.Radius, targetPos.Z)
					ballState.Position = ballState.Position:Lerp(targetPos, math.clamp(stepDt * 18, 0, 1))
					ballState.Velocity = hrp.AssemblyLinearVelocity
					ballState.Spin = Vector3.zero
				end
			else
				ballState = BallPhysics.Step(ballState, stepDt, halfL, halfW)

				-- AI Goalkeepers step & save check
				local aiSaved, clearVel = GoalkeeperAI.Step(stepDt, ballState.Position, ballState.Velocity, currentMode)
				if aiSaved and clearVel then
					ballState.Velocity = clearVel
					ballState.Spin = Vector3.zero
					if onAISaveCallback then
						onAISaveCallback()
					end
				end

				-- Player GK & Dribble pickup checks
				for _, player in ipairs(Players:GetPlayers()) do
					local char = player.Character
					local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
					local hum = char and char:FindFirstChildOfClass("Humanoid")
					if hrp and hum and hum.Health > 0 then
						local dist = (hrp.Position - ballState.Position).Magnitude

						if divingPlayers[player.UserId] and now < divingPlayers[player.UserId] and dist <= 7.2 then
							if ballState.Velocity.Magnitude > 22 then
								divingPlayers[player.UserId] = nil
								local deflectDir = Vector3.new(hrp.CFrame.LookVector.X, 0.25, hrp.CFrame.LookVector.Z).Unit
								ballState.Velocity = deflectDir * 36
								ballState.Spin = Vector3.zero
								recordTouch(player)
								if onSaveCallback then
									onSaveCallback(player)
								end
								break
							end
						end

						local cd = stealCooldowns[player.UserId] or 0
						if now > cd and dist <= Config.Ball.DribbleSnapRange and ballState.Position.Y <= 4.0 and ballState.Velocity.Magnitude < 55 then
							ownerPlayer = player
							recordTouch(player)
							break
						end
					end
				end
			end

			if matchPlaying then
				local p = ballState.Position
				local halfGoalW = modeCfg.GoalWidth * 0.5

				if p.Z <= -halfL - Config.Ball.Radius * 0.5 and math.abs(p.X) <= halfGoalW and p.Y <= modeCfg.GoalHeight then
					matchPlaying = false
					ballFrozen = true
					local assister = if previousTouchPlayer and lastTouchPlayer and previousTouchPlayer.Team == lastTouchPlayer.Team then previousTouchPlayer else nil
					if onGoalCallback then
						onGoalCallback("Away", lastTouchPlayer, assister)
					end
				elseif p.Z >= halfL + Config.Ball.Radius * 0.5 and math.abs(p.X) <= halfGoalW and p.Y <= modeCfg.GoalHeight then
					matchPlaying = false
					ballFrozen = true
					local assister = if previousTouchPlayer and lastTouchPlayer and previousTouchPlayer.Team == lastTouchPlayer.Team then previousTouchPlayer else nil
					if onGoalCallback then
						onGoalCallback("Home", lastTouchPlayer, assister)
					end
				elseif math.abs(p.X) > halfW + 1.5 then
					ownerPlayer = nil
					local clampedZ = math.clamp(p.Z, -halfL + 5, halfL - 5)
					local spot = Vector3.new(math.sign(p.X) * (halfW - 1.5), Config.Ball.Radius, clampedZ)
					local kickingTeam: "Home" | "Away" = if lastTouchPlayer and lastTouchPlayer.Team and lastTouchPlayer.Team.Name == "Home FC" then "Away" else "Home"
					BallManager.ResetToSpot(spot, false)
					if onSetPieceCallback then
						onSetPieceCallback("Throw-In", spot, kickingTeam)
					end
				elseif math.abs(p.Z) > halfL + 2.0 and math.abs(p.X) > halfGoalW then
					ownerPlayer = nil
					local endSign = math.sign(p.Z)
					local spot = Vector3.new(math.sign(p.X) * (halfW - 2), Config.Ball.Radius, endSign * (halfL - 2))
					local kickingTeam: "Home" | "Away" = if endSign < 0 then "Home" else "Away"
					BallManager.ResetToSpot(spot, false)
					if onSetPieceCallback then
						onSetPieceCallback("Corner / Goal Kick", spot, kickingTeam)
					end
				end
			end
		end

		local bp = ensureBallPart()
		local speed = ballState.Velocity.Magnitude
		if speed > 0.5 then
			local rollAxis = Vector3.new(ballState.Velocity.Z, 0, -ballState.Velocity.X)
			if rollAxis.Magnitude > 0.01 then
				bp.CFrame = CFrame.new(ballState.Position) * (bp.CFrame.Rotation * CFrame.fromAxisAngle(rollAxis.Unit, speed * stepDt / Config.Ball.Radius))
			else
				bp.CFrame = CFrame.new(ballState.Position) * bp.CFrame.Rotation
			end
		else
			bp.CFrame = CFrame.new(ballState.Position) * bp.CFrame.Rotation
		end

		broadcastAccum += stepDt
		if broadcastAccum >= 0.05 then
			broadcastAccum = 0
			broadcastState()
		end
	end)
end

return BallManager
]]></ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX000006">
      <Properties>
        <string name="Name">DataService</string>
        <ProtectedString name="Source"><![CDATA[--!strict
-- DataService.luau
-- Manages player profiles, Dream Squad/Club settings, Custom Kits, Celebrations, and Global Leaderboards.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Catalog = require(ReplicatedStorage.Shared.Catalog)
local Config = require(ReplicatedStorage.Shared.Config)
local Network = require(ReplicatedStorage.Shared.Network)

local DataService = {}

export type PlayerProfile = {
	Coins: number,
	Goals: number,
	Assists: number,
	Saves: number,
	Wins: number,
	Matches: number,
	ELO: number,
	ClubName: string,
	Formation: string,
	EquippedKit: string,
	EquippedCelebration: string,
	UnlockedKits: { [string]: boolean },
	UnlockedCelebrations: { [string]: boolean },
}

local profiles: { [number]: PlayerProfile } = {}
local profileStore: DataStore? = nil
local goalsLB: OrderedDataStore? = nil
local eloLB: OrderedDataStore? = nil
local winsLB: OrderedDataStore? = nil

local function defaultProfile(player: Player): PlayerProfile
	return {
		Coins = 200,
		Goals = 0,
		Assists = 0,
		Saves = 0,
		Wins = 0,
		Matches = 0,
		ELO = 1000,
		ClubName = player.DisplayName .. " FC",
		Formation = Catalog.Formations[1],
		EquippedKit = "classic_striker",
		EquippedCelebration = "knee_slide",
		UnlockedKits = { classic_striker = true },
		UnlockedCelebrations = { knee_slide = true },
	}
end

local function safePcall<T>(fn: () -> T): (boolean, T?)
	local ok, res = pcall(fn)
	return ok, if ok then res else nil
end

local function loadProfile(player: Player): PlayerProfile
	local prof = defaultProfile(player)
	if profileStore then
		local ok, saved = safePcall(function()
			return (profileStore :: DataStore):GetAsync("Player_" .. player.UserId)
		end)
		if ok and type(saved) == "table" then
			for k, v in pairs(saved) do
				(prof :: any)[k] = v
			end
		end
	end
	profiles[player.UserId] = prof
	return prof
end

local function saveProfile(player: Player)
	local prof = profiles[player.UserId]
	if not prof then
		return
	end
	if profileStore then
		pcall(function()
			(profileStore :: DataStore):SetAsync("Player_" .. player.UserId, prof)
		end)
	end
	if goalsLB then
		pcall(function()
			(goalsLB :: OrderedDataStore):SetAsync(tostring(player.UserId), math.floor(prof.Goals))
		end)
	end
	if eloLB then
		pcall(function()
			(eloLB :: OrderedDataStore):SetAsync(tostring(player.UserId), math.floor(prof.ELO))
		end)
	end
	if winsLB then
		pcall(function()
			(winsLB :: OrderedDataStore):SetAsync(tostring(player.UserId), math.floor(prof.Wins))
		end)
	end
end

local function syncToClient(player: Player)
	local prof = profiles[player.UserId]
	if prof then
		Network.GetEvent("ProfileUpdated"):FireClient(player, prof)
	end
end

function DataService.GetProfile(player: Player): PlayerProfile
	return profiles[player.UserId] or loadProfile(player)
end

function DataService.AwardGoal(player: Player)
	local prof = DataService.GetProfile(player)
	prof.Goals += 1
	prof.Coins += Config.Rewards.GoalCoins
	syncToClient(player)
end

function DataService.AwardAssist(player: Player)
	local prof = DataService.GetProfile(player)
	prof.Assists += 1
	prof.Coins += Config.Rewards.AssistCoins
	syncToClient(player)
end

function DataService.AwardSave(player: Player)
	local prof = DataService.GetProfile(player)
	prof.Saves += 1
	prof.Coins += Config.Rewards.SaveCoins
	syncToClient(player)
end

function DataService.GiveCoins(player: Player, amount: number)
	local prof = DataService.GetProfile(player)
	prof.Coins = math.max(0, prof.Coins + math.floor(amount))
	syncToClient(player)
end

function DataService.RecordMatchResult(player: Player, won: boolean)
	local prof = DataService.GetProfile(player)
	prof.Matches += 1
	if won then
		prof.Wins += 1
		prof.Coins += Config.Rewards.WinCoins
		prof.ELO = math.max(100, prof.ELO + Config.Rewards.WinELO)
	else
		prof.Coins += Config.Rewards.LossCoins
		prof.ELO = math.max(100, prof.ELO + Config.Rewards.LossELO)
	end
	syncToClient(player)
	task.spawn(saveProfile, player)
end

local function fetchLeaderboard(store: OrderedDataStore?, statKey: string): { { Name: string, Value: number, Club: string } }
	local entries = {}
	if store then
		local ok, pages = safePcall(function()
			return store:GetSortedAsync(false, 10)
		end)
		if ok and pages then
			local page = pages:GetCurrentPage()
			for _, item in ipairs(page) do
				local uid = tonumber(item.key)
				local name = "Player " .. tostring(item.key)
				if uid then
					local okName, resolved = pcall(function()
						return Players:GetNameFromUserIdAsync(uid)
					end)
					if okName and resolved then
						name = resolved
					end
				end
				table.insert(entries, {
					Name = name,
					Value = item.value,
					Club = "Club",
				})
			end
		end
	end

	-- Fallback/merge with active server players if DataStore is unavailable (e.g. Studio)
	if #entries == 0 then
		for _, p in ipairs(Players:GetPlayers()) do
			local prof = DataService.GetProfile(p)
			local val = (prof :: any)[statKey] or 0
			table.insert(entries, {
				Name = p.DisplayName,
				Value = val,
				Club = prof.ClubName,
			})
		end
		table.sort(entries, function(a, b)
			return a.Value > b.Value
		end)
	end

	return entries
end

function DataService.Init(onKitChanged: ((Player) -> ())?)
	pcall(function()
		profileStore = DataStoreService:GetDataStore("MapleviewSoccer_Profiles_v1")
		goalsLB = DataStoreService:GetOrderedDataStore("MapleviewSoccer_GoalsLB_v1")
		eloLB = DataStoreService:GetOrderedDataStore("MapleviewSoccer_ELOLB_v1")
		winsLB = DataStoreService:GetOrderedDataStore("MapleviewSoccer_WinsLB_v1")
	end)

	Players.PlayerAdded:Connect(function(player)
		loadProfile(player)
		syncToClient(player)
	end)

	Players.PlayerRemoving:Connect(function(player)
		saveProfile(player)
		profiles[player.UserId] = nil
	end)

	for _, player in ipairs(Players:GetPlayers()) do
		loadProfile(player)
	end

	Network.GetFunction("GetProfile").OnServerInvoke = function(player)
		return DataService.GetProfile(player)
	end

	Network.GetFunction("GetLeaderboards").OnServerInvoke = function(_player)
		return {
			Goals = fetchLeaderboard(goalsLB, "Goals"),
			ELO = fetchLeaderboard(eloLB, "ELO"),
			Wins = fetchLeaderboard(winsLB, "Wins"),
		}
	end

	Network.GetEvent("PurchaseItem").OnServerEvent:Connect(function(player, category: string, itemId: string)
		local prof = DataService.GetProfile(player)
		if category == "Kit" then
			local kit = Catalog.GetKit(itemId)
			if kit and not prof.UnlockedKits[itemId] and prof.Coins >= kit.Price then
				prof.Coins -= kit.Price
				prof.UnlockedKits[itemId] = true
				prof.EquippedKit = itemId
				syncToClient(player)
				if onKitChanged then
					onKitChanged(player)
				end
			end
		elseif category == "Celebration" then
			local cel = Catalog.GetCelebration(itemId)
			if cel and not prof.UnlockedCelebrations[itemId] and prof.Coins >= cel.Price then
				prof.Coins -= cel.Price
				prof.UnlockedCelebrations[itemId] = true
				prof.EquippedCelebration = itemId
				syncToClient(player)
			end
		end
	end)

	Network.GetEvent("EquipItem").OnServerEvent:Connect(function(player, category: string, itemId: string)
		local prof = DataService.GetProfile(player)
		if category == "Kit" and prof.UnlockedKits[itemId] then
			prof.EquippedKit = itemId
			syncToClient(player)
			if onKitChanged then
				onKitChanged(player)
			end
		elseif category == "Celebration" and prof.UnlockedCelebrations[itemId] then
			prof.EquippedCelebration = itemId
			syncToClient(player)
		elseif category == "Formation" then
			for _, f in ipairs(Catalog.Formations) do
				if f == itemId then
					prof.Formation = itemId
					syncToClient(player)
					break
				end
			end
		end
	end)

	Network.GetEvent("UpdateClubName").OnServerEvent:Connect(function(player, newName: string)
		if type(newName) ~= "string" then
			return
		end
		local trimmed = string.sub(newName:gsub("^%s*(.-)%s*$", "%1"), 1, 20)
		if #trimmed >= 2 then
			local prof = DataService.GetProfile(player)
			prof.ClubName = trimmed
			syncToClient(player)
		end
	end)
end

return DataService
]]></ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX000007">
      <Properties>
        <string name="Name">GoalkeeperAI</string>
        <ProtectedString name="Source"><![CDATA[--!strict
-- GoalkeeperAI.luau
-- Controls 3D AI Goalkeepers in both goals to track the ball, dive for shots, and make saves.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local ModelFactory = require(script.Parent.ModelFactory)

local GoalkeeperAI = {}

type KeeperState = {
	Model: Model?,
	Side: "Home" | "Away",
	Pos: Vector3,
	DiveTimer: number,
	DiveOffset: Vector3,
	SaveCooldown: number,
}

local homeGK: KeeperState = {
	Model = nil,
	Side = "Home",
	Pos = Vector3.new(0, 0, -106),
	DiveTimer = 0,
	DiveOffset = Vector3.zero,
	SaveCooldown = 0,
}

local awayGK: KeeperState = {
	Model = nil,
	Side = "Away",
	Pos = Vector3.new(0, 0, 106),
	DiveTimer = 0,
	DiveOffset = Vector3.zero,
	SaveCooldown = 0,
}

local function ensureKeepers(mode: Config.MatchMode)
	local stadium = Workspace:FindFirstChild("Stadium")
	if not stadium then
		return
	end
	local halfL = Config.MatchModes[mode].PitchLength * 0.5

	if not homeGK.Model or not homeGK.Model.Parent then
		homeGK.Pos = Vector3.new(0, 0, -halfL + 3.5)
		homeGK.Model = ModelFactory.BuildGoalkeeper(stadium, "HomeGoalkeeper", homeGK.Pos, Vector3.new(0, 0, 0), Color3.fromRGB(250, 204, 21))
	end
	if not awayGK.Model or not awayGK.Model.Parent then
		awayGK.Pos = Vector3.new(0, 0, halfL - 3.5)
		awayGK.Model = ModelFactory.BuildGoalkeeper(stadium, "AwayGoalkeeper", awayGK.Pos, Vector3.new(0, 0, 0), Color3.fromRGB(16, 185, 129))
	end
end

function GoalkeeperAI.Rebuild(mode: Config.MatchMode)
	if homeGK.Model then
		homeGK.Model:Destroy()
		homeGK.Model = nil
	end
	if awayGK.Model then
		awayGK.Model:Destroy()
		awayGK.Model = nil
	end
	ensureKeepers(mode)
end

-- Returns (saved: boolean, clearVelocity: Vector3?)
function GoalkeeperAI.Step(dt: number, ballPos: Vector3, ballVel: Vector3, mode: Config.MatchMode): (boolean, Vector3?)
	ensureKeepers(mode)

	local modeCfg = Config.MatchModes[mode]
	local halfL = modeCfg.PitchLength * 0.5
	local maxSlideX = modeCfg.GoalWidth * 0.5 - 2.0

	local savedAny = false
	local clearVel: Vector3? = nil

	for _, gk in ipairs({ homeGK, awayGK }) do
		local isHome = (gk.Side == "Home")
		local baseZ = if isHome then (-halfL + 3.5) else (halfL - 3.5)
		local forwardZ = if isHome then 1 else -1

		gk.SaveCooldown = math.max(0, gk.SaveCooldown - dt)

		-- Track ball X position smoothly
		local targetX = math.clamp(ballPos.X, -maxSlideX, maxSlideX)
		local moveSpeed = 16
		local newX = gk.Pos.X + (targetX - gk.Pos.X) * math.clamp(dt * moveSpeed * 0.35, 0, 1)

		-- Trigger dive if a fast shot is heading toward this goal
		local headingToGoal = (isHome and ballVel.Z < -18 and ballPos.Z < -halfL * 0.25)
			or ((not isHome) and ballVel.Z > 18 and ballPos.Z > halfL * 0.25)
		if headingToGoal and gk.DiveTimer <= 0 and (ballPos - gk.Pos).Magnitude < 48 then
			gk.DiveTimer = 0.65
			local diveX = math.clamp(ballPos.X - gk.Pos.X, -6, 6)
			local diveY = math.clamp(ballPos.Y - 2.5, 0, 3.8)
			gk.DiveOffset = Vector3.new(diveX * 0.5, diveY, 0)
		end

		if gk.DiveTimer > 0 then
			gk.DiveTimer -= dt
		else
			gk.DiveOffset = gk.DiveOffset:Lerp(Vector3.zero, math.clamp(dt * 8, 0, 1))
		end

		gk.Pos = Vector3.new(newX, 0, baseZ)
		local displayPos = gk.Pos + gk.DiveOffset

		if gk.Model and gk.Model.PrimaryPart then
			local lookTarget = Vector3.new(ballPos.X, displayPos.Y + 3.2, ballPos.Z)
			if (lookTarget - (displayPos + Vector3.new(0, 3.2, 0))).Magnitude < 0.1 then
				lookTarget = displayPos + Vector3.new(0, 3.2, forwardZ * 10)
			end
			local targetCF = CFrame.lookAt(displayPos + Vector3.new(0, 3.2, 0), lookTarget)
			local currentPivot = gk.Model:GetPivot()
			local delta = targetCF * currentPivot:Inverse()
			-- Move all parts cleanly
			gk.Model:PivotTo(targetCF)
		end

		-- Save collision check
		local keeperCenter = displayPos + Vector3.new(0, 3.2, 0)
		if gk.SaveCooldown <= 0 and (ballPos - keeperCenter).Magnitude <= 4.6 and ballVel.Magnitude > 12 then
			gk.SaveCooldown = 0.75
			savedAny = true
			local outDir = Vector3.new((ballPos.X - keeperCenter.X) * 0.4, 0.32, forwardZ).Unit
			clearVel = outDir * 56
		end
	end

	return savedAny, clearVel
end

return GoalkeeperAI
]]></ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX000008">
      <Properties>
        <string name="Name">KitAndCelebrationService</string>
        <ProtectedString name="Source"><![CDATA[--!strict
-- KitAndCelebrationService.luau
-- Applies custom kits to player characters and executes procedural goal celebrations.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Catalog = require(ReplicatedStorage.Shared.Catalog)
local Network = require(ReplicatedStorage.Shared.Network)

local KitAndCelebrationService = {}

local getProfileFn: ((Player) -> any)? = nil

function KitAndCelebrationService.ApplyKit(player: Player)
	local character = player.Character
	if not character or not getProfileFn then
		return
	end
	local prof = getProfileFn(player)
	local kit = Catalog.GetKit(prof.EquippedKit) or Catalog.Kits[1]

	-- Determine team tint for shorts/trim if on a team
	local teamAccent = kit.Secondary
	if player.Team then
		teamAccent = player.Team.TeamColor.Color
	end

	-- Remove existing Shirt/Pants so kit colors show crisply on any rig
	for _, child in ipairs(character:GetChildren()) do
		if child:IsA("Shirt") or child:IsA("Pants") or child:IsA("ShirtGraphic") then
			child:Destroy()
		end
	end

	for _, part in ipairs(character:GetDescendants()) do
		if part:IsA("BasePart") then
			local n = part.Name
			if n == "Torso" or n == "UpperTorso" or n == "LowerTorso" then
				part.Color = kit.Primary
			elseif string.find(n, "Arm") or string.find(n, "Hand") then
				-- Keep sleeves matching primary kit
				if string.find(n, "UpperArm") then
					part.Color = kit.Primary
				end
			elseif string.find(n, "Leg") or n == "LeftUpperLeg" or n == "RightUpperLeg" then
				part.Color = kit.Secondary
			elseif string.find(n, "Foot") then
				part.Color = kit.Accent
			end
		end
	end

	-- Overhead Club & Kit Nameplate
	local head = character:FindFirstChild("Head")
	if head and head:IsA("BasePart") then
		local old = head:FindFirstChild("PlayerTag")
		if old then
			old:Destroy()
		end
		local bb = Instance.new("BillboardGui")
		bb.Name = "PlayerTag"
		bb.Size = UDim2.fromOffset(160, 44)
		bb.StudsOffset = Vector3.new(0, 2.8, 0)
		bb.AlwaysOnTop = true
		bb.MaxDistance = 90
		bb.Parent = head

		local nameLbl = Instance.new("TextLabel")
		nameLbl.Size = UDim2.new(1, 0, 0.55, 0)
		nameLbl.BackgroundTransparency = 1
		nameLbl.Text = player.DisplayName
		nameLbl.TextColor3 = Color3.new(1, 1, 1)
		nameLbl.TextStrokeTransparency = 0.25
		nameLbl.Font = Enum.Font.GothamBold
		nameLbl.TextScaled = true
		nameLbl.Parent = bb

		local clubLbl = Instance.new("TextLabel")
		clubLbl.Size = UDim2.new(1, 0, 0.45, 0)
		clubLbl.Position = UDim2.fromScale(0, 0.55)
		clubLbl.BackgroundTransparency = 1
		clubLbl.Text = string.upper(prof.ClubName or "CLUB")
		clubLbl.TextColor3 = teamAccent
		clubLbl.TextStrokeTransparency = 0.35
		clubLbl.Font = Enum.Font.GothamSemibold
		clubLbl.TextScaled = true
		clubLbl.Parent = bb
	end
end

function KitAndCelebrationService.PlayCelebration(player: Player)
	local character = player.Character
	if not character or not getProfileFn then
		return
	end
	local hrp = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not hrp or not humanoid then
		return
	end

	local prof = getProfileFn(player)
	local celId = prof.EquippedCelebration or "knee_slide"

	-- Broadcast celebration VFX to all clients
	Network.GetEvent("CelebrationTrigger"):FireAllClients(player, celId)

	task.spawn(function()
		if celId == "knee_slide" then
			local forward = hrp.CFrame.LookVector
			hrp.AssemblyLinearVelocity = forward * 52 + Vector3.new(0, 8, 0)
			humanoid.Sit = true
			task.wait(1.6)
			humanoid.Sit = false
		elseif celId == "siuuu_leap" then
			hrp.AssemblyLinearVelocity = Vector3.new(0, 46, 0) + hrp.CFrame.LookVector * 12
			local startCF = hrp.CFrame
			for i = 1, 12 do
				task.wait(0.04)
				if hrp.Parent then
					hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(15), 0)
				end
			end
			task.wait(0.3)
			if hrp.Parent then
				hrp.CFrame = CFrame.new(hrp.Position) * startCF.Rotation * CFrame.Angles(0, math.pi, 0)
			end
		elseif celId == "backflip" then
			hrp.AssemblyLinearVelocity = Vector3.new(0, 52, 0) - hrp.CFrame.LookVector * 8
			for i = 1, 18 do
				task.wait(0.035)
				if hrp.Parent then
					hrp.CFrame = hrp.CFrame * CFrame.Angles(math.rad(20), 0, 0)
				end
			end
		elseif celId == "trophy_lift" then
			-- Spawn a temporary golden mini-cup above player's hands
			local cup = Instance.new("Part")
			cup.Name = "CelebrationCup"
			cup.Shape = Enum.PartType.Cylinder
			cup.Size = Vector3.new(2.4, 1.4, 1.4)
			cup.Color = Color3.fromRGB(250, 204, 21)
			cup.Material = Enum.Material.Neon
			cup.CanCollide = false
			cup.Anchored = true
			cup.Parent = workspace

			local t0 = os.clock()
			while os.clock() - t0 < 2.5 and hrp.Parent do
				cup.CFrame = CFrame.new(hrp.Position + Vector3.new(0, 4.5 + math.sin(os.clock() * 6) * 0.3, 0))
					* CFrame.Angles(0, os.clock() * 3, math.rad(90))
				task.wait()
			end
			cup:Destroy()
		end
	end)
end

function KitAndCelebrationService.Init(profileGetter: (Player) -> any)
	getProfileFn = profileGetter

	Players.PlayerAdded:Connect(function(player)
		player.CharacterAdded:Connect(function()
			task.wait(0.15)
			KitAndCelebrationService.ApplyKit(player)
		end)
	end)

	for _, player in ipairs(Players:GetPlayers()) do
		if player.Character then
			task.spawn(KitAndCelebrationService.ApplyKit, player)
		end
	end

	Network.GetEvent("CelebrationTrigger").OnServerEvent:Connect(function(player)
		KitAndCelebrationService.PlayCelebration(player)
	end)
end

return KitAndCelebrationService
]]></ProtectedString>
      </Properties>
    </Item>
    <Item class="Script" referent="RBX000009">
      <Properties>
        <string name="Name">MatchManager</string>
        <ProtectedString name="Source"><![CDATA[--!strict
-- MatchManager.server.luau
-- Orchestrates teams, Lobby/Training Pitch, 5v5/11v11 modes, Stadium themes, Admin Panel (ninja373670), and Trophy Ceremony.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Teams = game:GetService("Teams")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Network = require(ReplicatedStorage.Shared.Network)

local BallManager = require(script.Parent.BallManager)
local DataService = require(script.Parent.DataService)
local GoalkeeperAI = require(script.Parent.GoalkeeperAI)
local KitAndCelebrationService = require(script.Parent.KitAndCelebrationService)
local ModelFactory = require(script.Parent.ModelFactory)
local StadiumBuilder = require(script.Parent.StadiumBuilder)

Network.InitServer()

local function getOrCreateTeam(name: string, color: BrickColor): Team
	local existing = Teams:FindFirstChild(name)
	if existing and existing:IsA("Team") then
		return existing
	end
	local t = Instance.new("Team")
	t.Name = name
	t.TeamColor = color
	t.AutoAssignable = false
	t.Parent = Teams
	return t
end

local homeTeam = getOrCreateTeam(Config.Teams.Home.Name, Config.Teams.Home.Color)
local awayTeam = getOrCreateTeam(Config.Teams.Away.Name, Config.Teams.Away.Color)

DataService.Init(function(player)
	KitAndCelebrationService.ApplyKit(player)
end)
KitAndCelebrationService.Init(DataService.GetProfile)

local currentMode: Config.MatchMode = Config.DefaultMode
local currentStadium: Config.StadiumThemeId = Config.DefaultStadium
local modeVotes: { [number]: Config.MatchMode } = {}

local matchPhase = "Intermission"
local halfNumber = 1
local timeRemaining = Config.IntermissionSeconds
local homeScore = 0
local awayScore = 0
local statusBanner = "Lobby Training Pitch — Next Match Starting Soon"
local goalScoredFlag = false
local forceSkipPhase = false
local afkPlayers: { [number]: boolean } = {}
local discoEndTime = 0

local function isAdmin(player: Player): boolean
	return player.Name == Config.AdminUsername or RunService:IsStudio()
end

local function giveHammerIfAdmin(player: Player)
	if not isAdmin(player) then
		return
	end
	local backpack = player:FindFirstChildOfClass("Backpack")
	local char = player.Character
	if (backpack and backpack:FindFirstChild("Hammer")) or (char and char:FindFirstChild("Hammer")) then
		return
	end
	if backpack then
		local hammer = ModelFactory.BuildHammerTool()
		hammer.Activated:Connect(function()
			Network.GetEvent("OpenHammerPanel"):FireClient(player)
		end)
		hammer.Parent = backpack
	end
end

local function assignTeamBalanced(player: Player)
	local homeCount = #homeTeam:GetPlayers()
	local awayCount = #awayTeam:GetPlayers()
	player.Team = if homeCount <= awayCount then homeTeam else awayTeam
end

Players.PlayerAdded:Connect(function(player)
	assignTeamBalanced(player)
	player.CharacterAdded:Connect(function()
		task.wait(0.15)
		KitAndCelebrationService.ApplyKit(player)
		giveHammerIfAdmin(player)
	end)
end)

Players.PlayerRemoving:Connect(function(player)
	afkPlayers[player.UserId] = nil
end)

for _, p in ipairs(Players:GetPlayers()) do
	if not p.Team then
		assignTeamBalanced(p)
	end
	giveHammerIfAdmin(p)
end

Network.GetEvent("VoteMatchMode").OnServerEvent:Connect(function(player: Player, mode: string)
	if mode == "5v5" or mode == "11v11" then
		modeVotes[player.UserId] = mode :: Config.MatchMode
	end
end)

local function resolveModeVote(): Config.MatchMode
	local v5, v11 = 0, 0
	for _, m in pairs(modeVotes) do
		if m == "5v5" then
			v5 += 1
		else
			v11 += 1
		end
	end
	return if v11 > v5 then "11v11" else "5v5"
end

local function broadcastMatchState()
	Network.GetEvent("MatchStateUpdate"):FireAllClients({
		Phase = matchPhase,
		Half = halfNumber,
		TimeRemaining = math.max(0, math.floor(timeRemaining)),
		HomeScore = homeScore,
		AwayScore = awayScore,
		Mode = currentMode,
		Stadium = currentStadium,
		Status = statusBanner,
	})
end

local function teleportPlayerToLobby(player: Player, idx: number)
	local c = Config.LobbyCenter
	local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if hrp then
		local offX = ((idx - 1) % 4 - 1.5) * 8
		hrp.CFrame = CFrame.lookAt(c + Vector3.new(offX, 3.5, -72), c + Vector3.new(0, 3.5, -56))
		hrp.AssemblyLinearVelocity = Vector3.zero
	end
end

local function teleportPlayersToLobby()
	for i, player in ipairs(Players:GetPlayers()) do
		teleportPlayerToLobby(player, i)
	end
end

local function positionPlayersForKickoff()
	local halfL = Config.MatchModes[currentMode].PitchLength * 0.5
	local homeIdx, awayIdx = 0, 0
	for i, player in ipairs(Players:GetPlayers()) do
		if afkPlayers[player.UserId] then
			teleportPlayerToLobby(player, i)
			continue
		end
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		if hrp then
			if player.Team == homeTeam then
				homeIdx += 1
				local offsetX = ((homeIdx - 1) % 3 - 1) * 14
				local offsetZ = -18 - math.floor((homeIdx - 1) / 3) * 18
				hrp.CFrame = CFrame.lookAt(Vector3.new(offsetX, 3.5, math.max(offsetZ, -halfL + 10)), Vector3.new(0, 3.5, 0))
			else
				awayIdx += 1
				local offsetX = ((awayIdx - 1) % 3 - 1) * 14
				local offsetZ = 18 + math.floor((awayIdx - 1) / 3) * 18
				hrp.CFrame = CFrame.lookAt(Vector3.new(offsetX, 3.5, math.min(offsetZ, halfL - 10)), Vector3.new(0, 3.5, 0))
			end
			hrp.AssemblyLinearVelocity = Vector3.zero
		end
	end
end

-- AFK / Join Match Toggle
Network.GetEvent("ToggleAFK").OnServerEvent:Connect(function(player: Player, isAfk: boolean)
	if type(isAfk) ~= "boolean" then
		return
	end
	afkPlayers[player.UserId] = isAfk
	player:SetAttribute("IsAFK", isAfk)
	if isAfk then
		teleportPlayerToLobby(player, 1)
	elseif matchPhase == "Playing" then
		local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if hrp then
			local z = if player.Team == homeTeam then -20 else 20
			hrp.CFrame = CFrame.lookAt(Vector3.new(0, 3.5, z), Vector3.new(0, 3.5, 0))
			hrp.AssemblyLinearVelocity = Vector3.zero
		end
	end
end)

local function startDiscoTacoParty()
	local alreadyRunning = os.clock() < discoEndTime
	discoEndTime = os.clock() + 180 -- 3 minutes!
	Network.GetEvent("DiscoPartyStart"):FireAllClients(180)
	if alreadyRunning then
		return
	end

	task.spawn(function()
		while os.clock() < discoEndTime do
			-- Rain 3D tacos over the stadium and lobby
			for i = 1, 3 do
				local onLobby = (i == 3)
				local center = if onLobby then Config.LobbyCenter else Vector3.zero
				local rx = (math.random() - 0.5) * 140
				local rz = (math.random() - 0.5) * 160
				local taco = ModelFactory.BuildTaco(center + Vector3.new(rx, 85, rz))
				taco.Parent = Workspace
				if taco.PrimaryPart then
					taco.PrimaryPart.AssemblyAngularVelocity = Vector3.new(math.random(-5, 5), math.random(-5, 5), math.random(-5, 5))
				end
				task.delay(5.5, function()
					if taco.Parent then
						taco:Destroy()
					end
				end)
			end
			task.wait(0.3)
		end
	end)
end

-- Hammer Panel Commands (strictly restricted to ninja373670)
Network.GetEvent("AdminCommand").OnServerEvent:Connect(function(player: Player, cmd: string, arg: any)
	if not isAdmin(player) then
		return
	end
	local halfL = Config.MatchModes[currentMode].PitchLength * 0.5

	if cmd == "FreeKick" then
		local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if hrp then
			local spot = Vector3.new(hrp.Position.X, Config.Ball.Radius, hrp.Position.Z)
			BallManager.ResetToSpot(spot, false)
			statusBanner = "FREE KICK AWARDED!"
			broadcastMatchState()
		end
	elseif cmd == "PenaltyHome" then
		local spot = Vector3.new(0, Config.Ball.Radius, halfL - Config.Kicks.GKBoxDepth * 0.68)
		BallManager.ResetToSpot(spot, false)
		statusBanner = "PENALTY KICK — HOME FC!"
		broadcastMatchState()
	elseif cmd == "PenaltyAway" then
		local spot = Vector3.new(0, Config.Ball.Radius, -(halfL - Config.Kicks.GKBoxDepth * 0.68))
		BallManager.ResetToSpot(spot, false)
		statusBanner = "PENALTY KICK — AWAY UNITED!"
		broadcastMatchState()
	elseif cmd == "SetStadium" and type(arg) == "string" and (Config.StadiumThemes :: any)[arg] then
		currentStadium = arg :: Config.StadiumThemeId
		StadiumBuilder.Build(currentMode, currentStadium)
		GoalkeeperAI.Rebuild(currentMode)
		statusBanner = "Stadium Changed: " .. (Config.StadiumThemes :: any)[arg].Name
		broadcastMatchState()
	elseif cmd == "SetMode" and (arg == "5v5" or arg == "11v11") then
		currentMode = arg :: Config.MatchMode
		StadiumBuilder.Build(currentMode, currentStadium)
		GoalkeeperAI.Rebuild(currentMode)
		BallManager.SetMatchActive(matchPhase == "Playing", currentMode)
		statusBanner = "Match Format Changed: " .. currentMode
		broadcastMatchState()
	elseif cmd == "ResetBall" then
		BallManager.ResetToSpot(Vector3.zero, false)
		statusBanner = "Ball Reset to Center"
		broadcastMatchState()
	elseif cmd == "AddGoalHome" then
		homeScore += 1
		broadcastMatchState()
	elseif cmd == "AddGoalAway" then
		awayScore += 1
		broadcastMatchState()
	elseif cmd == "SkipPhase" then
		forceSkipPhase = true
	elseif cmd == "GlobalChat" and type(arg) == "string" then
		local msg = string.sub(arg, 1, 140)
		if #msg > 0 then
			Network.GetEvent("GlobalAnnouncement"):FireAllClients(player.DisplayName, msg)
		end
	elseif cmd == "DiscoTacoParty" then
		startDiscoTacoParty()
		Network.GetEvent("GlobalAnnouncement"):FireAllClients(player.DisplayName, "DISCO PARTY & RAINING TACOS STARTED FOR 3 MINUTES!")
	elseif cmd == "GiveCoins" and type(arg) == "table" then
		local targetId = tonumber(arg.TargetUserId)
		local amount = tonumber(arg.Amount) or 0
		if targetId and amount ~= 0 then
			local targetPlayer = Players:GetPlayerByUserId(targetId)
			if targetPlayer then
				DataService.GiveCoins(targetPlayer, amount)
			end
		end
	end
end)

-- Build initial stadium + lobby + goalkeepers
StadiumBuilder.Build(currentMode, currentStadium)
GoalkeeperAI.Rebuild(currentMode)

BallManager.Init(
	function(scoringTeam, scorer, assister)
		if goalScoredFlag or matchPhase ~= "Playing" then
			return
		end
		goalScoredFlag = true
		if scoringTeam == "Home" then
			homeScore += 1
		else
			awayScore += 1
		end

		if scorer then
			DataService.AwardGoal(scorer)
			KitAndCelebrationService.PlayCelebration(scorer)
		end
		if assister and assister ~= scorer then
			DataService.AwardAssist(assister)
		end

		statusBanner = string.format(
			"GOAL! %s (%s)",
			if scorer then scorer.DisplayName else scoringTeam,
			if scoringTeam == "Home" then Config.Teams.Home.Name else Config.Teams.Away.Name
		)

		Network.GetEvent("GoalScoredVFX"):FireAllClients({
			ScoringTeam = scoringTeam,
			ScorerName = if scorer then scorer.DisplayName else scoringTeam,
			AssisterName = if assister and assister ~= scorer then assister.DisplayName else nil,
		})
		broadcastMatchState()

		task.delay(Config.GoalCelebrationSeconds, function()
			goalScoredFlag = false
			if matchPhase == "Playing" then
				BallManager.ResetToSpot(Vector3.zero, false)
				positionPlayersForKickoff()
				BallManager.SetMatchActive(true, currentMode)
				statusBanner = "Kickoff!"
				broadcastMatchState()
			end
		end)
	end,
	function(keeper)
		DataService.AwardSave(keeper)
		statusBanner = "GREAT SAVE by " .. keeper.DisplayName .. "!"
		broadcastMatchState()
	end,
	function()
		statusBanner = "KEEPER SAVE!"
		broadcastMatchState()
	end,
	function(kind, _spot, team)
		local teamName = if team == "Home" then Config.Teams.Home.Name else Config.Teams.Away.Name
		statusBanner = string.format("%s — %s", kind, teamName)
		broadcastMatchState()
	end
)

local function waitCountdown(seconds: number, pauseOnGoal: boolean)
	timeRemaining = seconds
	forceSkipPhase = false
	while timeRemaining > 0 and not forceSkipPhase do
		broadcastMatchState()
		task.wait(1)
		if not (pauseOnGoal and goalScoredFlag) then
			timeRemaining -= 1
		end
	end
end

-- Main Match Loop
task.spawn(function()
	while true do
		matchPhase = "Intermission"
		halfNumber = 1
		homeScore = 0
		awayScore = 0
		BallManager.SetMatchActive(false, currentMode)
		statusBanner = "Lobby Training Pitch — Vote 5v5 or 11v11!"
		local oldTrophy = Workspace:FindFirstChild("ChampionshipTrophy")
		if oldTrophy then
			oldTrophy:Destroy()
		end
		teleportPlayersToLobby()
		waitCountdown(Config.IntermissionSeconds, false)

		local nextMode = resolveModeVote()
		if nextMode ~= currentMode then
			currentMode = nextMode
			StadiumBuilder.Build(currentMode, currentStadium)
			GoalkeeperAI.Rebuild(currentMode)
		end

		-- 1st Half
		matchPhase = "Playing"
		halfNumber = 1
		statusBanner = "1st Half — Kickoff!"
		BallManager.ResetToSpot(Vector3.zero, false)
		positionPlayersForKickoff()
		BallManager.SetMatchActive(true, currentMode)
		waitCountdown(Config.MatchModes[currentMode].HalfDurationSeconds, true)

		-- Half-Time
		matchPhase = "HalfTime"
		BallManager.SetMatchActive(false, currentMode)
		statusBanner = "Half-Time Break"
		waitCountdown(Config.HalfTimeSeconds, false)

		-- 2nd Half
		matchPhase = "Playing"
		halfNumber = 2
		statusBanner = "2nd Half — Kickoff!"
		BallManager.ResetToSpot(Vector3.zero, false)
		positionPlayersForKickoff()
		BallManager.SetMatchActive(true, currentMode)
		waitCountdown(Config.MatchModes[currentMode].HalfDurationSeconds, true)

		-- Trophy Ceremony
		matchPhase = "TrophyCeremony"
		BallManager.SetMatchActive(false, currentMode)
		local winner: "Home" | "Away" | "Draw" = "Draw"
		local winnerName = "Draw Match"
		if homeScore > awayScore then
			winner = "Home"
			winnerName = Config.Teams.Home.Name
		elseif awayScore > homeScore then
			winner = "Away"
			winnerName = Config.Teams.Away.Name
		end

		statusBanner = "FULL TIME! " .. winnerName .. " Wins!"
		ModelFactory.BuildTrophy(Workspace, Vector3.new(0, 0, 0), "CHAMPIONS: " .. string.upper(winnerName))
		Network.GetEvent("TrophyCeremonyStart"):FireAllClients(winnerName)

		for _, player in ipairs(Players:GetPlayers()) do
			if winner ~= "Draw" then
				local isHome = (player.Team == homeTeam)
				local won = (winner == "Home" and isHome) or (winner == "Away" and not isHome)
				DataService.RecordMatchResult(player, won)
			end
		end

		waitCountdown(Config.TrophyCeremonySeconds, false)
	end
end)
]]></ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX000010">
      <Properties>
        <string name="Name">ModelFactory</string>
        <ProtectedString name="Source"><![CDATA[--!strict
-- ModelFactory.luau
-- Procedurally constructs custom 3D models: Championship Trophy, Dugouts, Floodlight Towers, 3D Fans, and 3D Goalkeepers.

local ModelFactory = {}

local function part(props: {
	Name: string,
	Size: Vector3,
	CFrame: CFrame,
	Color: Color3,
	Material: Enum.Material?,
	Shape: Enum.PartType?,
	Transparency: number?,
	CanCollide: boolean?,
	Reflectance: number?,
	Parent: Instance,
}): Part
	local p = Instance.new("Part")
	p.Name = props.Name
	p.Size = props.Size
	p.CFrame = props.CFrame
	p.Color = props.Color
	p.Material = props.Material or Enum.Material.SmoothPlastic
	if props.Shape then
		p.Shape = props.Shape
	end
	p.Transparency = props.Transparency or 0
	p.CanCollide = if props.CanCollide ~= nil then props.CanCollide else true
	p.Reflectance = props.Reflectance or 0
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = props.Parent
	return p
end

-- Custom 3D Championship Trophy Model
function ModelFactory.BuildTrophy(parent: Instance, position: Vector3, titleText: string): Model
	local model = Instance.new("Model")
	model.Name = "ChampionshipTrophy"

	local gold = Color3.fromRGB(250, 204, 21)
	local darkMarble = Color3.fromRGB(15, 23, 42)

	-- Tiered Base
	part({
		Name = "BaseLower",
		Size = Vector3.new(6.5, 1.4, 6.5),
		CFrame = CFrame.new(position + Vector3.new(0, 0.7, 0)),
		Color = darkMarble,
		Material = Enum.Material.Marble,
		Parent = model,
	})
	part({
		Name = "BaseUpper",
		Size = Vector3.new(4.4, 1.1, 4.4),
		CFrame = CFrame.new(position + Vector3.new(0, 1.95, 0)),
		Color = gold,
		Material = Enum.Material.Metal,
		Reflectance = 0.4,
		Parent = model,
	})
	-- Stem
	part({
		Name = "Stem",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(2.4, 1.3, 1.3),
		CFrame = CFrame.new(position + Vector3.new(0, 3.6, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Color = gold,
		Material = Enum.Material.Metal,
		Reflectance = 0.5,
		Parent = model,
	})
	-- Cup Bowl
	local bowl = part({
		Name = "CupBowl",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(3.2, 3.8, 3.8),
		CFrame = CFrame.new(position + Vector3.new(0, 6.1, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Color = gold,
		Material = Enum.Material.Metal,
		Reflectance = 0.55,
		Parent = model,
	})
	-- Handles
	for _, side in ipairs({ -1, 1 }) do
		part({
			Name = "Handle_" .. side,
			Size = Vector3.new(0.5, 2.2, 1.2),
			CFrame = CFrame.new(position + Vector3.new(side * 2.25, 6.1, 0)),
			Color = gold,
			Material = Enum.Material.Metal,
			Reflectance = 0.45,
			Parent = model,
		})
	end
	-- Glowing Crown Ball
	part({
		Name = "CrownOrb",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(1.5, 1.5, 1.5),
		CFrame = CFrame.new(position + Vector3.new(0, 8.2, 0)),
		Color = Color3.fromRGB(255, 235, 120),
		Material = Enum.Material.Neon,
		CanCollide = false,
		Parent = model,
	})

	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(260, 56)
	bb.StudsOffset = Vector3.new(0, 4.5, 0)
	bb.AlwaysOnTop = true
	bb.Parent = bowl

	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.fromScale(1, 1)
	lbl.BackgroundTransparency = 1
	lbl.Text = titleText
	lbl.TextColor3 = gold
	lbl.TextStrokeTransparency = 0.2
	lbl.Font = Enum.Font.GothamBlack
	lbl.TextScaled = true
	lbl.Parent = bb

	model.Parent = parent
	return model
end

-- Custom 3D Team Dugout Shelter & Bench
function ModelFactory.BuildDugout(parent: Instance, cf: CFrame, teamColor: Color3, name: string): Model
	local model = Instance.new("Model")
	model.Name = name

	-- Back & Roof Glass
	part({
		Name = "BackGlass",
		Size = Vector3.new(24, 7.5, 0.4),
		CFrame = cf * CFrame.new(0, 3.75, 2.5),
		Color = Color3.fromRGB(148, 163, 184),
		Material = Enum.Material.Glass,
		Transparency = 0.45,
		Parent = model,
	})
	part({
		Name = "Roof",
		Size = Vector3.new(24.6, 0.4, 6),
		CFrame = cf * CFrame.new(0, 7.6, 0) * CFrame.Angles(math.rad(-8), 0, 0),
		Color = teamColor,
		Material = Enum.Material.Metal,
		Parent = model,
	})
	-- Bench Seat
	part({
		Name = "Bench",
		Size = Vector3.new(21, 0.6, 2.2),
		CFrame = cf * CFrame.new(0, 1.8, 0.8),
		Color = Color3.fromRGB(30, 41, 59),
		Material = Enum.Material.SmoothPlastic,
		Parent = model,
	})
	for i = -2, 2 do
		part({
			Name = "SeatBack_" .. i,
			Size = Vector3.new(2.6, 2.4, 0.4),
			CFrame = cf * CFrame.new(i * 4.2, 3.1, 1.7),
			Color = teamColor,
			Parent = model,
		})
	end

	model.Parent = parent
	return model
end

-- Custom 3D Floodlight Tower with Neon Light Bank & SpotLights
function ModelFactory.BuildFloodlightTower(parent: Instance, basePos: Vector3, accentColor: Color3, idx: number): Model
	local model = Instance.new("Model")
	model.Name = "FloodlightTower_" .. idx

	local towerH = 105
	-- Main Steel Pylon
	part({
		Name = "Pylon",
		Size = Vector3.new(4.2, towerH, 4.2),
		CFrame = CFrame.new(basePos + Vector3.new(0, towerH * 0.5, 0)),
		Color = Color3.fromRGB(51, 65, 85),
		Material = Enum.Material.Metal,
		Parent = model,
	})
	-- Accent Neon Ring
	part({
		Name = "TowerAccent",
		Size = Vector3.new(4.8, 2.0, 4.8),
		CFrame = CFrame.new(basePos + Vector3.new(0, towerH * 0.85, 0)),
		Color = accentColor,
		Material = Enum.Material.Neon,
		CanCollide = false,
		Parent = model,
	})

	-- Light Bank aimed at center pitch
	local headPos = basePos + Vector3.new(0, towerH, 0)
	local headCF = CFrame.lookAt(headPos, Vector3.new(0, 0, 0))
	local bank = part({
		Name = "LightBank",
		Size = Vector3.new(18, 9, 2.5),
		CFrame = headCF,
		Color = Color3.fromRGB(30, 41, 59),
		Material = Enum.Material.Metal,
		Parent = model,
	})
	local bulbs = part({
		Name = "Bulbs",
		Size = Vector3.new(16, 7.5, 0.6),
		CFrame = headCF * CFrame.new(0, 0, -1.4),
		Color = Color3.fromRGB(255, 250, 232),
		Material = Enum.Material.Neon,
		CanCollide = false,
		Parent = model,
	})

	local spot = Instance.new("SpotLight")
	spot.Brightness = 5.5
	spot.Range = 320
	spot.Angle = 82
	spot.Color = Color3.fromRGB(255, 248, 228)
	spot.Face = Enum.NormalId.Front
	spot.Parent = bulbs

	model.Parent = parent
	return model
end

-- Custom 3D Articulated Goalkeeper Model
function ModelFactory.BuildGoalkeeper(parent: Instance, name: string, pos: Vector3, lookAtPos: Vector3, jerseyColor: Color3): Model
	local model = Instance.new("Model")
	model.Name = name

	local cf = CFrame.lookAt(pos, lookAtPos)
	local skin = Color3.fromRGB(234, 192, 150)
	local glove = Color3.fromRGB(250, 204, 21)

	local root = part({
		Name = "Root",
		Size = Vector3.new(2.2, 2.6, 1.2),
		CFrame = cf * CFrame.new(0, 3.2, 0),
		Color = jerseyColor,
		CanCollide = false,
		Parent = model,
	})
	model.PrimaryPart = root

	part({
		Name = "Head",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(1.7, 1.7, 1.7),
		CFrame = cf * CFrame.new(0, 5.2, 0),
		Color = skin,
		CanCollide = false,
		Parent = model,
	})
	-- Arms & Keeper Gloves
	for _, side in ipairs({ -1, 1 }) do
		part({
			Name = "Arm_" .. side,
			Size = Vector3.new(0.75, 2.3, 0.75),
			CFrame = cf * CFrame.new(side * 1.65, 3.4, 0) * CFrame.Angles(0, 0, math.rad(side * 18)),
			Color = jerseyColor,
			CanCollide = false,
			Parent = model,
		})
		part({
			Name = "Glove_" .. side,
			Size = Vector3.new(0.95, 0.95, 0.95),
			CFrame = cf * CFrame.new(side * 2.0, 2.2, -0.3),
			Color = glove,
			Material = Enum.Material.Neon,
			CanCollide = false,
			Parent = model,
		})
	end
	-- Legs & Boots
	for _, side in ipairs({ -1, 1 }) do
		part({
			Name = "Leg_" .. side,
			Size = Vector3.new(0.9, 2.0, 0.9),
			CFrame = cf * CFrame.new(side * 0.55, 1.1, 0),
			Color = Color3.fromRGB(20, 24, 34),
			CanCollide = false,
			Parent = model,
		})
	end

	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(90, 28)
	bb.StudsOffset = Vector3.new(0, 3.2, 0)
	bb.AlwaysOnTop = true
	bb.Parent = root

	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.fromScale(1, 1)
	lbl.BackgroundTransparency = 1
	lbl.Text = "GK"
	lbl.TextColor3 = glove
	lbl.TextStrokeTransparency = 0.2
	lbl.Font = Enum.Font.GothamBlack
	lbl.TextScaled = true
	lbl.Parent = bb

	model.Parent = parent
	return model
end

-- Custom 3D Stadium Jumbotron Scoreboard
function ModelFactory.BuildJumbotron(parent: Instance, cf: CFrame, accentColor: Color3, titleText: string): Model
	local model = Instance.new("Model")
	model.Name = "StadiumJumbotron"

	part({
		Name = "Frame",
		Size = Vector3.new(44, 18, 2.5),
		CFrame = cf,
		Color = Color3.fromRGB(15, 23, 42),
		Material = Enum.Material.Metal,
		Parent = model,
	})
	local screen = part({
		Name = "Screen",
		Size = Vector3.new(41, 15, 0.5),
		CFrame = cf * CFrame.new(0, 0, -1.3),
		Color = Color3.fromRGB(20, 30, 50),
		Material = Enum.Material.Neon,
		CanCollide = false,
		Parent = model,
	})
	part({
		Name = "TopTrim",
		Size = Vector3.new(45, 1.2, 3),
		CFrame = cf * CFrame.new(0, 9.4, 0),
		Color = accentColor,
		Material = Enum.Material.Neon,
		CanCollide = false,
		Parent = model,
	})

	local sg = Instance.new("SurfaceGui")
	sg.Face = Enum.NormalId.Front
	sg.Parent = screen

	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.fromScale(1, 1)
	lbl.BackgroundTransparency = 1
	lbl.Text = titleText
	lbl.TextColor3 = Color3.fromRGB(250, 204, 21)
	lbl.Font = Enum.Font.GothamBlack
	lbl.TextScaled = true
	lbl.Parent = sg

	model.Parent = parent
	return model
end

-- Custom 3D Glowing Lobby Fountain
function ModelFactory.BuildFountain(parent: Instance, pos: Vector3, accentColor: Color3): Model
	local model = Instance.new("Model")
	model.Name = "LobbyFountain"

	part({
		Name = "PoolRim",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(1.8, 18, 18),
		CFrame = CFrame.new(pos + Vector3.new(0, 0.9, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(30, 41, 59),
		Material = Enum.Material.Marble,
		Parent = model,
	})
	local water = part({
		Name = "Water",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(1.4, 16, 16),
		CFrame = CFrame.new(pos + Vector3.new(0, 1.2, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(56, 189, 248),
		Material = Enum.Material.Glass,
		Transparency = 0.25,
		CanCollide = false,
		Parent = model,
	})
	part({
		Name = "CenterPillar",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(5, 3, 3),
		CFrame = CFrame.new(pos + Vector3.new(0, 2.5, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Color = accentColor,
		Material = Enum.Material.Neon,
		Parent = model,
	})

	local pe = Instance.new("ParticleEmitter")
	pe.Color = ColorSequence.new(Color3.fromRGB(186, 230, 253), Color3.fromRGB(255, 255, 255))
	pe.Size = NumberSequence.new(0.45)
	pe.Speed = NumberRange.new(12, 18)
	pe.SpreadAngle = Vector2.new(35, 35)
	pe.Acceleration = Vector3.new(0, -28, 0)
	pe.Lifetime = NumberRange.new(0.9, 1.3)
	pe.Rate = 35
	pe.Parent = water

	model.Parent = parent
	return model
end

-- Custom 3D Stylized Lobby Tree
function ModelFactory.BuildTree(parent: Instance, pos: Vector3): Model
	local model = Instance.new("Model")
	model.Name = "LobbyTree"

	part({
		Name = "Planter",
		Size = Vector3.new(5, 1.6, 5),
		CFrame = CFrame.new(pos + Vector3.new(0, 0.8, 0)),
		Color = Color3.fromRGB(51, 65, 85),
		Material = Enum.Material.Marble,
		Parent = model,
	})
	part({
		Name = "Trunk",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(8, 1.4, 1.4),
		CFrame = CFrame.new(pos + Vector3.new(0, 5, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(120, 72, 42),
		Material = Enum.Material.Wood,
		Parent = model,
	})
	part({
		Name = "Canopy1",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(7, 5.5, 7),
		CFrame = CFrame.new(pos + Vector3.new(0, 10, 0)),
		Color = Color3.fromRGB(34, 197, 94),
		Material = Enum.Material.Grass,
		Parent = model,
	})
	model.Parent = parent
	return model
end

-- Custom 3D VIP Lounge Booth
function ModelFactory.BuildLoungeBooth(parent: Instance, cf: CFrame, accentColor: Color3): Model
	local model = Instance.new("Model")
	model.Name = "LoungeBooth"

	part({
		Name = "SofaSeat",
		Size = Vector3.new(10, 1.4, 3.2),
		CFrame = cf * CFrame.new(0, 0.7, 0),
		Color = Color3.fromRGB(30, 41, 59),
		Parent = model,
	})
	part({
		Name = "SofaBack",
		Size = Vector3.new(10, 2.2, 0.8),
		CFrame = cf * CFrame.new(0, 2.0, 1.2),
		Color = accentColor,
		Parent = model,
	})
	part({
		Name = "Table",
		Size = Vector3.new(6, 1.2, 2.4),
		CFrame = cf * CFrame.new(0, 0.6, -4.2),
		Color = Color3.fromRGB(148, 163, 184),
		Material = Enum.Material.Glass,
		Transparency = 0.3,
		Parent = model,
	})
	model.Parent = parent
	return model
end

-- Custom 3D Hammer Tool (labeled "Hammer", opens the secret panel when activated)
function ModelFactory.BuildHammerTool(): Tool
	local tool = Instance.new("Tool")
	tool.Name = "Hammer"
	tool.ToolTip = "Hammer"
	tool.CanBeDropped = false

	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(0.45, 3.4, 0.45)
	handle.Color = Color3.fromRGB(120, 72, 42)
	handle.Material = Enum.Material.Wood
	handle.Parent = tool

	local head = Instance.new("Part")
	head.Name = "HammerHead"
	head.Size = Vector3.new(1.4, 1.2, 2.6)
	head.Color = Color3.fromRGB(250, 204, 21)
	head.Material = Enum.Material.Metal
	head.Reflectance = 0.35
	head.CanCollide = false
	head.CFrame = handle.CFrame * CFrame.new(0, 1.8, 0)
	head.Parent = tool

	local weld = Instance.new("WeldConstraint")
	weld.Part0 = handle
	weld.Part1 = head
	weld.Parent = head

	local glow = Instance.new("Part")
	glow.Name = "HammerGlow"
	glow.Size = Vector3.new(1.5, 0.35, 2.7)
	glow.Color = Color3.fromRGB(239, 68, 68)
	glow.Material = Enum.Material.Neon
	glow.CanCollide = false
	glow.CFrame = head.CFrame
	glow.Parent = tool

	local weld2 = Instance.new("WeldConstraint")
	weld2.Part0 = head
	weld2.Part1 = glow
	weld2.Parent = glow

	return tool
end

-- Custom 3D Taco Model for Raining Tacos Disco Party!
function ModelFactory.BuildTaco(position: Vector3): Model
	local taco = Instance.new("Model")
	taco.Name = "RainingTaco"

	local shell = Instance.new("Part")
	shell.Name = "Shell"
	shell.Size = Vector3.new(2.2, 1.3, 1.0)
	shell.Position = position
	shell.Color = Color3.fromRGB(245, 190, 70)
	shell.Material = Enum.Material.SmoothPlastic
	shell.CanCollide = false
	shell.Anchored = false
	shell.Parent = taco
	taco.PrimaryPart = shell

	local filling = Instance.new("Part")
	filling.Name = "Filling"
	filling.Size = Vector3.new(1.9, 0.7, 0.7)
	filling.Position = position + Vector3.new(0, 0.45, 0)
	filling.Color = Color3.fromRGB(115, 62, 34)
	filling.CanCollide = false
	filling.Parent = taco

	local lettuce = Instance.new("Part")
	lettuce.Name = "Lettuce"
	lettuce.Size = Vector3.new(2.0, 0.35, 0.8)
	lettuce.Position = position + Vector3.new(0, 0.75, 0)
	lettuce.Color = Color3.fromRGB(74, 222, 128)
	lettuce.CanCollide = false
	lettuce.Parent = taco

	for _, p in ipairs({ filling, lettuce }) do
		local w = Instance.new("WeldConstraint")
		w.Part0 = shell
		w.Part1 = p
		w.Parent = p
	end

	return taco
end

return ModelFactory
]]></ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX000011">
      <Properties>
        <string name="Name">StadiumBuilder</string>
        <ProtectedString name="Source"><![CDATA[--!strict
-- StadiumBuilder.luau
-- Procedurally constructs a realistic FIFA stadium (with 3D fans, roof canopies, LED boards, dugouts, floodlights)
-- plus a cool Lobby Lounge with a Practice Training Pitch and 4 selectable Stadium Themes.

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Teams = game:GetService("Teams")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local ModelFactory = require(script.Parent.ModelFactory)

local StadiumBuilder = {}

local function makePart(props: {
	Name: string,
	Size: Vector3,
	CFrame: CFrame,
	Color: Color3,
	Material: Enum.Material?,
	Transparency: number?,
	CanCollide: boolean?,
	Parent: Instance,
}): Part
	local p = Instance.new("Part")
	p.Name = props.Name
	p.Size = props.Size
	p.CFrame = props.CFrame
	p.Color = props.Color
	p.Material = props.Material or Enum.Material.SmoothPlastic
	p.Transparency = props.Transparency or 0
	p.CanCollide = if props.CanCollide ~= nil then props.CanCollide else true
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = props.Parent
	return p
end

local function setupAtmosphere(themeCfg: any)
	Lighting.ClockTime = themeCfg.ClockTime
	Lighting.Brightness = 2.4
	Lighting.Ambient = themeCfg.Ambient
	Lighting.OutdoorAmbient = themeCfg.Ambient
	Lighting.FogEnd = 1600

	local atmo = Lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere")
	atmo.Density = 0.2
	atmo.Offset = 0.25
	atmo.Color = Color3.fromRGB(150, 180, 230)
	atmo.Decay = Color3.fromRGB(40, 50, 80)
	atmo.Glare = 0.35
	atmo.Haze = 1.1
	atmo.Parent = Lighting

	local bloom = Lighting:FindFirstChildOfClass("BloomEffect") or Instance.new("BloomEffect")
	bloom.Intensity = 0.45
	bloom.Size = 18
	bloom.Threshold = 1.15
	bloom.Parent = Lighting
end

local function buildLine(parent: Instance, name: string, p1: Vector3, p2: Vector3, width: number)
	local delta = p2 - p1
	local len = delta.Magnitude
	if len < 0.01 then
		return
	end
	local mid = (p1 + p2) * 0.5
	local cf = CFrame.lookAt(mid, p2)
	makePart({
		Name = name,
		Size = Vector3.new(width, 0.08, len + width),
		CFrame = cf,
		Color = Color3.fromRGB(245, 248, 252),
		CanCollide = false,
		Parent = parent,
	})
end

local function buildCircle(parent: Instance, center: Vector3, radius: number, segments: number, lineWidth: number)
	for i = 1, segments do
		local a1 = ((i - 1) / segments) * math.pi * 2
		local a2 = (i / segments) * math.pi * 2
		local p1 = center + Vector3.new(math.cos(a1) * radius, 0, math.sin(a1) * radius)
		local p2 = center + Vector3.new(math.cos(a2) * radius, 0, math.sin(a2) * radius)
		buildLine(parent, "CircleSeg_" .. i, p1, p2, lineWidth)
	end
end

local function buildGoal(parent: Instance, name: string, centerPos: Vector3, facingSign: number, goalWidth: number, goalHeight: number)
	local goalFolder = Instance.new("Folder")
	goalFolder.Name = name
	goalFolder.Parent = parent

	local postRadius = 0.45
	local depth = 7.5
	local halfW = goalWidth * 0.5
	local white = Color3.fromRGB(245, 247, 250)

	makePart({
		Name = "LeftPost",
		Size = Vector3.new(postRadius * 2, goalHeight, postRadius * 2),
		CFrame = CFrame.new(centerPos + Vector3.new(-halfW, goalHeight * 0.5, 0)),
		Color = white,
		Material = Enum.Material.Metal,
		Parent = goalFolder,
	})
	makePart({
		Name = "RightPost",
		Size = Vector3.new(postRadius * 2, goalHeight, postRadius * 2),
		CFrame = CFrame.new(centerPos + Vector3.new(halfW, goalHeight * 0.5, 0)),
		Color = white,
		Material = Enum.Material.Metal,
		Parent = goalFolder,
	})
	makePart({
		Name = "Crossbar",
		Size = Vector3.new(goalWidth + postRadius * 2, postRadius * 2, postRadius * 2),
		CFrame = CFrame.new(centerPos + Vector3.new(0, goalHeight, 0)),
		Color = white,
		Material = Enum.Material.Metal,
		Parent = goalFolder,
	})

	local backZ = centerPos.Z + facingSign * depth
	local midZ = (centerPos.Z + backZ) * 0.5
	local netColor = Color3.fromRGB(235, 240, 245)

	makePart({
		Name = "BackNet",
		Size = Vector3.new(goalWidth, goalHeight, 0.25),
		CFrame = CFrame.new(centerPos.X, centerPos.Y + goalHeight * 0.5, backZ),
		Color = netColor,
		Material = Enum.Material.Fabric,
		Transparency = 0.55,
		Parent = goalFolder,
	})
	makePart({
		Name = "TopNet",
		Size = Vector3.new(goalWidth, 0.25, depth),
		CFrame = CFrame.new(centerPos.X, centerPos.Y + goalHeight, midZ),
		Color = netColor,
		Material = Enum.Material.Fabric,
		Transparency = 0.55,
		Parent = goalFolder,
	})
	makePart({
		Name = "LeftNet",
		Size = Vector3.new(0.25, goalHeight, depth),
		CFrame = CFrame.new(centerPos.X - halfW, centerPos.Y + goalHeight * 0.5, midZ),
		Color = netColor,
		Material = Enum.Material.Fabric,
		Transparency = 0.55,
		Parent = goalFolder,
	})
	makePart({
		Name = "RightNet",
		Size = Vector3.new(0.25, goalHeight, depth),
		CFrame = CFrame.new(centerPos.X + halfW, centerPos.Y + goalHeight * 0.5, midZ),
		Color = netColor,
		Material = Enum.Material.Fabric,
		Transparency = 0.55,
		Parent = goalFolder,
	})
end

-- Spawns 3D Fan Figures in the stands
local function spawn3DFans(parent: Instance, startPos: Vector3, stepVec: Vector3, count: number, palette: { Color3 })
	local skinTones = {
		Color3.fromRGB(240, 200, 165),
		Color3.fromRGB(198, 145, 102),
		Color3.fromRGB(130, 86, 56),
		Color3.fromRGB(252, 224, 196),
	}
	for i = 0, count - 1 do
		local pos = startPos + stepVec * i
		local jersey = palette[(i % #palette) + 1]
		local skin = skinTones[(i % #skinTones) + 1]

		local torso = makePart({
			Name = "FanTorso",
			Size = Vector3.new(1.8, 2.0, 1.0),
			CFrame = CFrame.new(pos + Vector3.new(0, 1.0, 0)),
			Color = jersey,
			CanCollide = false,
			Parent = parent,
		})
		torso:SetAttribute("IsFan", true)
		torso:SetAttribute("BaseY", pos.Y + 1.0)

		makePart({
			Name = "FanHead",
			Size = Vector3.new(1.1, 1.1, 1.1),
			CFrame = CFrame.new(pos + Vector3.new(0, 2.6, 0)),
			Color = skin,
			CanCollide = false,
			Parent = parent,
		})
	end
end

local function buildStandsRoofAndFans(parent: Instance, halfL: number, halfW: number, themeCfg: any)
	local standsFolder = Instance.new("Folder")
	standsFolder.Name = "Stands"
	standsFolder.Parent = parent

	local margin = 22
	local tierCount = 5
	local tierDepth = 7.5
	local tierHeight = 4.6
	local standColor = themeCfg.StandColor
	local accent = themeCfg.Accent
	local crowdPalette = {
		Config.Teams.Home.PrimaryColor,
		Config.Teams.Away.PrimaryColor,
		accent,
		Color3.fromRGB(241, 245, 249),
		Color3.fromRGB(16, 185, 129),
	}

	-- Perimeter Glowing LED Ad Boards
	local adY = 1.6
	makePart({
		Name = "LEDBoard_West",
		Size = Vector3.new(0.8, 3.2, halfL * 2 + 12),
		CFrame = CFrame.new(-halfW - 10, adY, 0),
		Color = accent,
		Material = Enum.Material.Neon,
		Parent = standsFolder,
	})
	makePart({
		Name = "LEDBoard_East",
		Size = Vector3.new(0.8, 3.2, halfL * 2 + 12),
		CFrame = CFrame.new(halfW + 10, adY, 0),
		Color = accent,
		Material = Enum.Material.Neon,
		Parent = standsFolder,
	})

	-- Side stands (East & West) + Roof Canopies + 3D Fans
	for _, side in ipairs({ -1, 1 }) do
		for t = 1, tierCount do
			local x = side * (halfW + margin + (t - 0.5) * tierDepth)
			local y = (t - 0.5) * tierHeight
			makePart({
				Name = "SideTier_" .. side .. "_" .. t,
				Size = Vector3.new(tierDepth, tierHeight, (halfL + margin) * 2),
				CFrame = CFrame.new(x, y, 0),
				Color = standColor,
				Material = Enum.Material.Concrete,
				Parent = standsFolder,
			})

			-- Add 3D fans on tiers 2 and 4
			if t == 2 or t == 4 then
				local fanCount = math.floor((halfL * 1.8) / 14)
				spawn3DFans(
					standsFolder,
					Vector3.new(x, y + tierHeight * 0.5, -halfL * 0.85),
					Vector3.new(0, 0, 14),
					fanCount,
					crowdPalette
				)
			end
		end

		-- Stadium Roof Canopy + Overhead Rim Lights
		local roofX = side * (halfW + margin + tierCount * tierDepth * 0.55)
		local roofY = tierCount * tierHeight + 14
		local roof = makePart({
			Name = "SideRoof_" .. side,
			Size = Vector3.new(tierCount * tierDepth + 14, 1.8, (halfL + margin) * 2 + 12),
			CFrame = CFrame.new(roofX, roofY, 0) * CFrame.Angles(0, 0, math.rad(-side * 12)),
			Color = Color3.fromRGB(30, 41, 59),
			Material = Enum.Material.Metal,
			Parent = standsFolder,
		})
		makePart({
			Name = "RoofNeonTrim_" .. side,
			Size = Vector3.new(1.2, 1.2, (halfL + margin) * 2 + 10),
			CFrame = CFrame.new(side * (halfW + margin - 3), roofY - 4, 0),
			Color = accent,
			Material = Enum.Material.Neon,
			CanCollide = false,
			Parent = standsFolder,
		})
		local pl = Instance.new("PointLight")
		pl.Brightness = 1.6
		pl.Range = 90
		pl.Color = Color3.fromRGB(255, 248, 230)
		pl.Parent = roof
	end

	-- End stands (North & South) + 3D Fans + Roofs
	for _, endSign in ipairs({ -1, 1 }) do
		for t = 1, tierCount do
			local z = endSign * (halfL + margin + (t - 0.5) * tierDepth)
			local y = (t - 0.5) * tierHeight
			makePart({
				Name = "EndTier_" .. endSign .. "_" .. t,
				Size = Vector3.new((halfW + margin) * 2, tierHeight, tierDepth),
				CFrame = CFrame.new(0, y, z),
				Color = standColor,
				Material = Enum.Material.Concrete,
				Parent = standsFolder,
			})
			if t == 3 then
				local fanCount = math.floor((halfW * 1.7) / 14)
				spawn3DFans(
					standsFolder,
					Vector3.new(-halfW * 0.8, y + tierHeight * 0.5, z),
					Vector3.new(14, 0, 0),
					fanCount,
					crowdPalette
				)
			end
		end

		local roofZ = endSign * (halfL + margin + tierCount * tierDepth * 0.55)
		local roofY = tierCount * tierHeight + 14
		makePart({
			Name = "EndRoof_" .. endSign,
			Size = Vector3.new((halfW + margin) * 2 + 12, 1.8, tierCount * tierDepth + 14),
			CFrame = CFrame.new(0, roofY, roofZ) * CFrame.Angles(math.rad(endSign * 12), 0, 0),
			Color = Color3.fromRGB(30, 41, 59),
			Material = Enum.Material.Metal,
			Parent = standsFolder,
		})
	end

	-- 3D Team Dugouts & Player Tunnel along West Touchline
	ModelFactory.BuildDugout(standsFolder, CFrame.new(-halfW - 14, 0, -28) * CFrame.Angles(0, math.rad(-90), 0), Config.Teams.Home.PrimaryColor, "HomeDugout")
	ModelFactory.BuildDugout(standsFolder, CFrame.new(-halfW - 14, 0, 28) * CFrame.Angles(0, math.rad(-90), 0), Config.Teams.Away.PrimaryColor, "AwayDugout")
	makePart({
		Name = "PlayerTunnelArch",
		Size = Vector3.new(10, 10, 14),
		CFrame = CFrame.new(-halfW - 16, 5, 0),
		Color = Color3.fromRGB(20, 26, 38),
		Material = Enum.Material.Concrete,
		Parent = standsFolder,
	})

	-- Giant 3D Jumbotron Scoreboards above North & South Stands
	ModelFactory.BuildJumbotron(standsFolder, CFrame.new(0, 38, -halfL - margin - 12) * CFrame.Angles(0, math.rad(180), 0), accent, "MAPLEVIEW STADIUM")
	ModelFactory.BuildJumbotron(standsFolder, CFrame.new(0, 38, halfL + margin + 12), accent, "WORLD CHAMPIONSHIP")

	-- 4 Towering 3D Floodlight Towers
	local towerCorners = {
		Vector3.new(-halfW - margin - 20, 0, -halfL - margin - 20),
		Vector3.new(halfW + margin + 20, 0, -halfL - margin - 20),
		Vector3.new(-halfW - margin - 20, 0, halfL + margin + 20),
		Vector3.new(halfW + margin + 20, 0, halfL + margin + 20),
	}
	for i, basePos in ipairs(towerCorners) do
		ModelFactory.BuildFloodlightTower(standsFolder, basePos, accent, i)
	end
end

-- Detailed VIP Stadium Lobby + Training Pitch
local function buildLobby(parent: Instance, accent: Color3)
	local lobby = Instance.new("Folder")
	lobby.Name = "Lobby"
	lobby.Parent = parent

	local center = Config.LobbyCenter

	-- Main Lobby Plaza Floor + Glowing Neon Rim
	makePart({
		Name = "LobbyFloor",
		Size = Vector3.new(176, 3, 200),
		CFrame = CFrame.new(center + Vector3.new(0, -1.5, 0)),
		Color = Color3.fromRGB(18, 26, 44),
		Material = Enum.Material.Marble,
		Parent = lobby,
	})
	for _, side in ipairs({ -1, 1 }) do
		makePart({
			Name = "LobbyNeonWalkway_" .. side,
			Size = Vector3.new(1.2, 0.25, 190),
			CFrame = CFrame.new(center + Vector3.new(side * 84, 0.12, 0)),
			Color = accent,
			Material = Enum.Material.Neon,
			CanCollide = false,
			Parent = lobby,
		})
	end

	-- Glowing Neon Entrance Arch
	for _, side in ipairs({ -1, 1 }) do
		makePart({
			Name = "ArchPillar_" .. side,
			Size = Vector3.new(3.5, 24, 3.5),
			CFrame = CFrame.new(center + Vector3.new(side * 22, 12, -88)),
			Color = Color3.fromRGB(30, 41, 59),
			Material = Enum.Material.Metal,
			Parent = lobby,
		})
	end
	local archTop = makePart({
		Name = "ArchTop",
		Size = Vector3.new(48, 4.5, 4),
		CFrame = CFrame.new(center + Vector3.new(0, 24, -88)),
		Color = accent,
		Material = Enum.Material.Neon,
		Parent = lobby,
	})
	local archLight = Instance.new("PointLight")
	archLight.Brightness = 3.5
	archLight.Range = 140
	archLight.Color = accent
	archLight.Parent = archTop

	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(360, 75)
	bb.StudsOffset = Vector3.new(0, 5.5, 0)
	bb.AlwaysOnTop = true
	bb.Parent = archTop

	local signLbl = Instance.new("TextLabel")
	signLbl.Size = UDim2.fromScale(1, 1)
	signLbl.BackgroundTransparency = 1
	signLbl.Text = "MAPLEVIEW VIP STADIUM LOBBY"
	signLbl.TextColor3 = accent
	signLbl.TextStrokeTransparency = 0.2
	signLbl.Font = Enum.Font.GothamBlack
	signLbl.TextScaled = true
	signLbl.Parent = bb

	-- Center 3D Glowing Fountain & Trophy Showcase
	ModelFactory.BuildFountain(lobby, center + Vector3.new(0, 0, -56), accent)
	ModelFactory.BuildTrophy(lobby, center + Vector3.new(-30, 0, -68), "CHAMPIONSHIP CUP")
	ModelFactory.BuildTrophy(lobby, center + Vector3.new(30, 0, -68), "GOLDEN BOOT")

	-- 6 Stylized 3D Trees around the Plaza
	for _, treePos in ipairs({
		Vector3.new(-68, 0, -76),
		Vector3.new(68, 0, -76),
		Vector3.new(-68, 0, -34),
		Vector3.new(68, 0, -34),
		Vector3.new(-68, 0, 12),
		Vector3.new(68, 0, 12),
	}) do
		ModelFactory.BuildTree(lobby, center + treePos)
	end

	-- 4 VIP Lounge Booths (Sofas + Glass Tables)
	ModelFactory.BuildLoungeBooth(lobby, CFrame.new(center + Vector3.new(-48, 0, -56)) * CFrame.Angles(0, math.rad(-90), 0), Config.Teams.Home.PrimaryColor)
	ModelFactory.BuildLoungeBooth(lobby, CFrame.new(center + Vector3.new(48, 0, -56)) * CFrame.Angles(0, math.rad(90), 0), Config.Teams.Away.PrimaryColor)
	ModelFactory.BuildLoungeBooth(lobby, CFrame.new(center + Vector3.new(-48, 0, -30)) * CFrame.Angles(0, math.rad(-90), 0), accent)
	ModelFactory.BuildLoungeBooth(lobby, CFrame.new(center + Vector3.new(48, 0, -30)) * CFrame.Angles(0, math.rad(90), 0), accent)

	-- Elevated VIP Viewing Deck overlooking Training Pitch
	makePart({
		Name = "VIPDeck",
		Size = Vector3.new(64, 1.5, 16),
		CFrame = CFrame.new(center + Vector3.new(0, 7.5, -24)),
		Color = Color3.fromRGB(30, 41, 59),
		Material = Enum.Material.Glass,
		Transparency = 0.25,
		Parent = lobby,
	})
	makePart({
		Name = "VIPStairs",
		Size = Vector3.new(12, 1.2, 18),
		CFrame = CFrame.new(center + Vector3.new(-36, 3.8, -24)) * CFrame.Angles(0, 0, math.rad(25)),
		Color = Color3.fromRGB(51, 65, 85),
		Parent = lobby,
	})

	-- Lobby SpawnLocations
	for i = -1, 1 do
		local sp = Instance.new("SpawnLocation")
		sp.Name = "LobbySpawn_" .. i
		sp.Size = Vector3.new(8, 0.5, 8)
		sp.CFrame = CFrame.lookAt(center + Vector3.new(i * 14, 0.3, -76), center + Vector3.new(0, 0.3, -56))
		sp.Anchored = true
		sp.CanCollide = false
		sp.Transparency = 1
		sp.Duration = 0
		sp.Neutral = true
		sp.Parent = lobby
	end

	-- Detailed Practice Training Pitch inside the Lobby
	local trainCenter = center + Vector3.new(0, 0, 34)
	local trainL = 104
	local trainW = 84
	for i = 1, 8 do
		local z = trainCenter.Z - trainL * 0.5 + (i - 0.5) * (trainL / 8)
		makePart({
			Name = "TrainTurf_" .. i,
			Size = Vector3.new(trainW, 0.4, trainL / 8),
			CFrame = CFrame.new(trainCenter.X, 0.1, z),
			Color = if i % 2 == 0 then Color3.fromRGB(34, 139, 64) else Color3.fromRGB(40, 156, 72),
			Material = Enum.Material.Grass,
			Parent = lobby,
		})
	end

	local ty = 0.32
	buildLine(lobby, "TrainLineL", Vector3.new(trainCenter.X - trainW * 0.5, ty, trainCenter.Z - trainL * 0.5), Vector3.new(trainCenter.X - trainW * 0.5, ty, trainCenter.Z + trainL * 0.5), 0.5)
	buildLine(lobby, "TrainLineR", Vector3.new(trainCenter.X + trainW * 0.5, ty, trainCenter.Z - trainL * 0.5), Vector3.new(trainCenter.X + trainW * 0.5, ty, trainCenter.Z + trainL * 0.5), 0.5)
	buildLine(lobby, "TrainStartLine", Vector3.new(trainCenter.X - trainW * 0.5, ty, trainCenter.Z - trainL * 0.5), Vector3.new(trainCenter.X + trainW * 0.5, ty, trainCenter.Z - trainL * 0.5), 0.5)
	buildLine(lobby, "TrainGoalLine", Vector3.new(trainCenter.X - trainW * 0.5, ty, trainCenter.Z + trainL * 0.5), Vector3.new(trainCenter.X + trainW * 0.5, ty, trainCenter.Z + trainL * 0.5), 0.5)
	buildLine(lobby, "TrainBoxF", Vector3.new(trainCenter.X - 24, ty, trainCenter.Z + trainL * 0.5 - 24), Vector3.new(trainCenter.X + 24, ty, trainCenter.Z + trainL * 0.5 - 24), 0.5)
	buildLine(lobby, "TrainBoxL", Vector3.new(trainCenter.X - 24, ty, trainCenter.Z + trainL * 0.5), Vector3.new(trainCenter.X - 24, ty, trainCenter.Z + trainL * 0.5 - 24), 0.5)
	buildLine(lobby, "TrainBoxR", Vector3.new(trainCenter.X + 24, ty, trainCenter.Z + trainL * 0.5), Vector3.new(trainCenter.X + 24, ty, trainCenter.Z + trainL * 0.5 - 24), 0.5)

	buildGoal(lobby, "TrainingGoal", Vector3.new(trainCenter.X, 0.3, trainCenter.Z + trainL * 0.5), 1, 24, 9.5)
	ModelFactory.BuildJumbotron(lobby, CFrame.new(trainCenter + Vector3.new(0, 22, trainL * 0.5 + 10)), accent, "TRAINING PITCH")

	for _, xOff in ipairs({ -7.5, 0, 7.5 }) do
		makePart({
			Name = "TargetRing_" .. xOff,
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.4, 3.6, 3.6),
			CFrame = CFrame.new(trainCenter.X + xOff, 6.2, trainCenter.Z + trainL * 0.5 + 1) * CFrame.Angles(0, math.rad(90), 0),
			Color = accent,
			Material = Enum.Material.Neon,
			CanCollide = false,
			Parent = lobby,
		})
	end

	-- 3 Practice Soccer Balls
	for i = -1, 1 do
		local pBall = Instance.new("Part")
		pBall.Name = "TrainingBall_" .. (i + 2)
		pBall.Shape = Enum.PartType.Ball
		pBall.Size = Vector3.one * (Config.Ball.Radius * 2)
		pBall.Position = trainCenter + Vector3.new(i * 12, Config.Ball.Radius + 0.5, -18)
		pBall.Color = Color3.fromRGB(248, 250, 252)
		pBall.Material = Enum.Material.SmoothPlastic
		pBall.Anchored = false
		pBall.CustomPhysicalProperties = PhysicalProperties.new(0.4, 0.3, 0.65, 1, 1)
		pBall:SetAttribute("IsTrainingBall", true)
		pBall.Parent = lobby
	end
end

function StadiumBuilder.Build(mode: Config.MatchMode, themeId: Config.StadiumThemeId?)
	local themeKey = themeId or Config.DefaultStadium
	local themeCfg = (Config.StadiumThemes :: any)[themeKey] or Config.StadiumThemes.WembleyNight
	setupAtmosphere(themeCfg)

	local existing = Workspace:FindFirstChild("Stadium")
	if existing then
		existing:Destroy()
	end

	local modeCfg = Config.MatchModes[mode]
	local halfL = modeCfg.PitchLength * 0.5
	local halfW = modeCfg.PitchWidth * 0.5

	local stadium = Instance.new("Folder")
	stadium.Name = "Stadium"
	stadium.Parent = Workspace

	-- Concrete stadium floor apron
	makePart({
		Name = "StadiumFloor",
		Size = Vector3.new(modeCfg.PitchWidth + 140, 4, modeCfg.PitchLength + 140),
		CFrame = CFrame.new(0, -2.1, 0),
		Color = Color3.fromRGB(35, 42, 54),
		Material = Enum.Material.Concrete,
		Parent = stadium,
	})

	-- Mowed grass stripes
	local stripeCount = 16
	local stripeLen = modeCfg.PitchLength / stripeCount
	for i = 1, stripeCount do
		local z = -halfL + (i - 0.5) * stripeLen
		local isEven = (i % 2 == 0)
		makePart({
			Name = "TurfStripe_" .. i,
			Size = Vector3.new(modeCfg.PitchWidth + 10, Config.TurfThickness, stripeLen),
			CFrame = CFrame.new(0, -Config.TurfThickness * 0.5, z),
			Color = if isEven then themeCfg.TurfA else themeCfg.TurfB,
			Material = Enum.Material.Grass,
			Parent = stadium,
		})
	end

	-- Pitch Lines
	local linesFolder = Instance.new("Folder")
	linesFolder.Name = "PitchLines"
	linesFolder.Parent = stadium

	local y = 0.05
	local lw = 0.65

	buildLine(linesFolder, "NorthGoalLine", Vector3.new(-halfW, y, -halfL), Vector3.new(halfW, y, -halfL), lw)
	buildLine(linesFolder, "SouthGoalLine", Vector3.new(-halfW, y, halfL), Vector3.new(halfW, y, halfL), lw)
	buildLine(linesFolder, "WestTouchline", Vector3.new(-halfW, y, -halfL), Vector3.new(-halfW, y, halfL), lw)
	buildLine(linesFolder, "EastTouchline", Vector3.new(halfW, y, -halfL), Vector3.new(halfW, y, halfL), lw)
	buildLine(linesFolder, "HalfwayLine", Vector3.new(-halfW, y, 0), Vector3.new(halfW, y, 0), lw)
	buildCircle(linesFolder, Vector3.new(0, y, 0), 22, 32, lw)

	makePart({
		Name = "CenterSpot",
		Size = Vector3.new(1.8, 0.08, 1.8),
		CFrame = CFrame.new(0, y, 0),
		Color = Color3.fromRGB(245, 248, 252),
		CanCollide = false,
		Parent = linesFolder,
	})

	local boxDepth = Config.Kicks.GKBoxDepth
	local boxHalfW = Config.Kicks.GKBoxWidth * 0.5
	for _, endSign in ipairs({ -1, 1 }) do
		local goalZ = endSign * halfL
		local boxZ = goalZ - endSign * boxDepth
		buildLine(linesFolder, "BoxFront_" .. endSign, Vector3.new(-boxHalfW, y, boxZ), Vector3.new(boxHalfW, y, boxZ), lw)
		buildLine(linesFolder, "BoxLeft_" .. endSign, Vector3.new(-boxHalfW, y, goalZ), Vector3.new(-boxHalfW, y, boxZ), lw)
		buildLine(linesFolder, "BoxRight_" .. endSign, Vector3.new(boxHalfW, y, goalZ), Vector3.new(boxHalfW, y, boxZ), lw)

		makePart({
			Name = "PenaltySpot_" .. endSign,
			Size = Vector3.new(1.6, 0.08, 1.6),
			CFrame = CFrame.new(0, y, goalZ - endSign * (boxDepth * 0.68)),
			Color = Color3.fromRGB(245, 248, 252),
			CanCollide = false,
			Parent = linesFolder,
		})
	end

	-- Corner flags
	local corners = {
		Vector3.new(-halfW, 0, -halfL),
		Vector3.new(halfW, 0, -halfL),
		Vector3.new(-halfW, 0, halfL),
		Vector3.new(halfW, 0, halfL),
	}
	for i, cPos in ipairs(corners) do
		makePart({
			Name = "CornerPole_" .. i,
			Size = Vector3.new(0.35, 5, 0.35),
			CFrame = CFrame.new(cPos + Vector3.new(0, 2.5, 0)),
			Color = Color3.fromRGB(250, 204, 21),
			CanCollide = false,
			Parent = stadium,
		})
		makePart({
			Name = "CornerFlag_" .. i,
			Size = Vector3.new(1.8, 1.1, 0.15),
			CFrame = CFrame.new(cPos + Vector3.new(0.9, 4.4, 0)),
			Color = Color3.fromRGB(239, 68, 68),
			Material = Enum.Material.Fabric,
			CanCollide = false,
			Parent = stadium,
		})
	end

	-- Goals
	buildGoal(stadium, "HomeGoal", Vector3.new(0, 0, -halfL), -1, modeCfg.GoalWidth, modeCfg.GoalHeight)
	buildGoal(stadium, "AwayGoal", Vector3.new(0, 0, halfL), 1, modeCfg.GoalWidth, modeCfg.GoalHeight)

	-- Stands, Roofs, 3D Fans, Dugouts & Floodlights
	buildStandsRoofAndFans(stadium, halfL, halfW, themeCfg)

	-- Lobby & Training Pitch
	buildLobby(stadium, themeCfg.Accent)
end

return StadiumBuilder
]]></ProtectedString>
