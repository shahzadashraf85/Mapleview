		local idx = table.find(all, selectedCoinPlayer) or 0
		selectedCoinPlayer = all[(idx % #all) + 1]
		if selectedCoinPlayer then
			coinTargetBtn.Text = "Coin Target: " .. selectedCoinPlayer.DisplayName .. " (Click to Cycle)"
